DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_MODEL="deepseek-v4-flash"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
AUTH_SECRET="change-to-a-long-random-string"
ADMIN_USERNAME="YUXII"

# 普通模式 Agent 计划链；设为 false 可回退旧链路
NORMAL_AGENT_PLAN=true

# 内容生成 Agent：翻译完成后直接调 DeepSeek 生成内容候选，再交给收敛 Agent。
CONTENT_AGENT_PLAN=true

AI_QUOTA_ENABLED=true
AI_QUOTA_DAILY_CALLS=500
AI_QUOTA_DAILY_TOKENS=1000000
AI_QUOTA_VISITOR_DAILY_CALLS=50
AI_QUOTA_VISITOR_DAILY_TOKENS=200000
