# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.vercel.example
!.env.edgeone.example

# vercel
.vercel

# local pnpm store
.pnpm-store/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local sqlite database
*.db
*.db-journal
prisma/dev.db

# local database backups
/backups/

# local public service logs and temporary tunnel state
.public-service/
.public-demo/
*.log
*.lnk

# local tools and agent configuration that should stay private
/tools/
.agents/
.claude/
.windsurf/

# 竞品分析抓取的参考资料（本地保留，不提交）
/.atypica/

# WeChat DevTools local settings
miniprogram/project.private.config.json
