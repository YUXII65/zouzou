generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
  binaryTargets   = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  active
  paused
  completed
  archived
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

enum ProjectStageStatus {
  active
  ready
  completed
  cancelled
}

enum Priority {
  low
  medium
  high
  urgent
}

enum InboxStatus {
  inbox
  processed
  ignored
}

enum InboxCategory {
  task
  project_note
  reference
  ignore
}

enum ReviewStatus {
  draft
  final
}

enum ReviewNextActionStatus {
  pending
  done
  cancelled
}

model User {
  id                String             @id @default(cuid())
  username          String             @unique
  passwordHash      String
  /// 展示用昵称（为空时回退到 username）
  displayName       String?
  /// 头像：客户端压缩后的 data URL（不做对象存储，保持部署简单）
  avatarUrl         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  projects          Project[]
  projectStages     ProjectStage[]
  projectTracks     ProjectTrack[]
  tasks             Task[]
  taskStickyNotes   TaskStickyNote[]
  inboxItems        InboxItem[]
  aiPlanFeedbacks   AiPlanFeedback[]
  userPreferences   UserPreference[]
  aiFeedbackEvents  AiFeedbackEvent[]
  reviews           Review[]
  reviewTasks       ReviewTask[]
  reviewNextActions ReviewNextAction[]
  aiUsageLogs       AiUsageLog[]
  usageEvents       UsageEvent[]

  @@map("users")
}

model Project {
  id                     String            @id @default(cuid())
  userId                 String
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name                   String
  objective              String
  status                 ProjectStatus     @default(active)
  /// 推进模式：normal / longterm / explore（v3.3）
  mode                   String            @default("normal")
  currentMilestone       String?
  notes                  String?
  createdFromInboxItemId String?           @unique
  createdFromInboxItem   InboxItem?        @relation("ProjectFromInbox", fields: [createdFromInboxItemId], references: [id], onDelete: SetNull)
  /// 探索模式的节奏说明（由 AI 判断，例如"每周两次"）
  cadence                String?
  lastReviewedAt         DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  tasks                  Task[]
  stages                 ProjectStage[]
  tracks                 ProjectTrack[]
  inboxItems             InboxItem[]
  reviewTasks            ReviewTask[]
  reviews                Review[]
  aiFeedbackEvents       AiFeedbackEvent[]

  @@index([userId])
  @@index([userId, status])
  @@map("projects")
}

model ProjectStage {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectId          String
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  order              Int
  title              String
  deliverable        String
  doneWhen           String?
  status             ProjectStageStatus @default(active)
  completedAt        DateTime?
  nextStageJson      String?
  nextStageUpdatedAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tasks              Task[]

  @@unique([projectId, order])
  @@index([userId, status])
  @@index([projectId, status])
  @@map("project_stages")
}

/**
 * 探索模式的「线路」。
 * 探索和长期的分界不是「有没有终点」，而是长期是一条线按阶段走、探索是
 * 多条线按主次演进。探索线路不强制多条：只对一个方向感兴趣时就只有一条主线。
 */
model ProjectTrack {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  order        Int
  name         String
  /// 这条线在发展 / 验证什么
  intent       String
  /// main | side —— 主次由反馈调整，不是创建时定死
  role         String    @default("main")
  /// active | paused | archived
  status       String    @default("active")
  /// 这条线现在练到哪 / 验证到哪
  currentFocus String?
  lastEventAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tasks        Task[]

  @@unique([projectId, order])
  @@index([userId, status])
  @@index([projectId, status])
  @@map("project_tracks")
}

model Task {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title            String
  shortTitle       String?
  notes            String?
  projectId        String?
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  stageId          String?
  stage            ProjectStage?     @relation(fields: [stageId], references: [id], onDelete: SetNull)
  trackId          String?
  track            ProjectTrack?     @relation(fields: [trackId], references: [id], onDelete: SetNull)
  status           TaskStatus        @default(todo)
  priority         Priority          @default(medium)
  scheduledDate    DateTime?
  dueDate          DateTime?
  focusDate        DateTime?
  completedAt      DateTime?
  executionMode    String?
  doneWhen         String?
  methodHint       String?
  completedBy      String?
  maxTurns         Int?
  toolPolicy       String?
  planOrder        Int?
  inboxItemId      String?
  inboxItem        InboxItem?        @relation(fields: [inboxItemId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reviewTasks      ReviewTask[]
  reviewNextAction ReviewNextAction?
  aiFeedbackEvents AiFeedbackEvent[]
  stickyNotes      TaskStickyNote[]

  @@index([userId])
  @@index([userId, status])
  @@index([stageId])
  @@index([trackId])
  @@map("tasks")
}

model TaskStickyNote {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceMessage String
  title         String
  encouragement String
  stepsJson     String
  nextStep      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, taskId, createdAt])
  @@map("task_sticky_notes")
}

model InboxItem {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  content          String
  source           String            @default("manual")
  status           InboxStatus       @default(inbox)
  category         InboxCategory?
  /// 首页选择的推进模式：smart 表示交给 AI 判断
  mode             String?
  title            String?
  projectId        String?
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  priority         Priority?
  dueDate          DateTime?
  aiSuggestionJson String?
  aiPlanJson       String?
  aiAnalyzedAt     DateTime?
  confirmedAt      DateTime?
  processedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tasks            Task[]
  createdProject   Project?          @relation("ProjectFromInbox")
  aiPlanFeedbacks  AiPlanFeedback[]
  aiFeedbackEvents AiFeedbackEvent[]

  @@index([userId])
  @@index([userId, status])
  @@map("inbox_items")
}

model AiPlanFeedback {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inboxItemId String?
  inboxItem   InboxItem? @relation(fields: [inboxItemId], references: [id], onDelete: SetNull)
  action      String
  planJson    String
  editedJson  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@map("ai_plan_feedbacks")
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  key       String
  value     String
  source    String   @default("manual")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key, source])
  @@index([userId])
  @@map("user_preferences")
}

model AiFeedbackEvent {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  source      String
  action      String
  inboxItemId String?
  inboxItem   InboxItem? @relation(fields: [inboxItemId], references: [id], onDelete: SetNull)
  taskId      String?
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  beforeJson  String?
  afterJson   String?
  detail      String?
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@map("ai_feedback_events")
}

model Review {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewDate      DateTime
  summary         String
  nextActions     String?
  decisionJson    String?
  /// 为空 = 按天复盘；不为空 = 某个项目（探索模式）的复盘
  projectId       String?
  project         Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status          ReviewStatus       @default(draft)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tasks           ReviewTask[]
  nextActionTasks ReviewNextAction[]

  @@unique([userId, reviewDate, projectId])
  @@index([userId])
  @@map("reviews")
}

model ReviewTask {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewId         String
  review           Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  taskId           String
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  titleAtReview    String
  statusAtReview   String
  priorityAtReview String
  createdAt        DateTime @default(now())

  @@unique([reviewId, taskId])
  @@index([userId])
  @@map("review_tasks")
}

model ReviewNextAction {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewId  String
  review    Review                 @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  title     String
  status    ReviewNextActionStatus @default(pending)
  sortOrder Int                    @default(0)
  taskId    String?                @unique
  task      Task?                  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([userId])
  @@map("review_next_actions")
}

model AiUsageLog {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  visitorId             String
  feature               String
  status                String   @default("ok")
  promptTokens          Int      @default(0)
  completionTokens      Int      @default(0)
  totalTokens           Int      @default(0)
  promptCacheHitTokens  Int?
  promptCacheMissTokens Int?
  model                 String?
  createdAt             DateTime @default(now())

  @@index([visitorId, createdAt])
  @@index([createdAt])
  @@index([userId])
  @@map("ai_usage_logs")
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  visitorId String?
  event     String
  page      String?
  detail    String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([event, createdAt])
  @@index([createdAt])
  @@map("usage_events")
}
