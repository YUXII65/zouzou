<view class="bottom-nav theme-{{theme}}">
  <view class="nav-item {{selected === 0 ? 'nav-item-active' : ''}}" data-key="today" bindtap="onTabTap">
    <image class="nav-icon" src="/assets/icons/nav-home{{selected === 0 ? (theme === 'dark' ? '-active-dark' : '-active') : ''}}.svg"></image>
    <text>首页</text>
  </view>
  <view class="nav-item {{selected === 1 ? 'nav-item-active' : ''}}" data-key="desk" bindtap="onTabTap">
    <image class="nav-icon" src="/assets/icons/nav-files{{selected === 1 ? (theme === 'dark' ? '-active-dark' : '-active') : ''}}.svg"></image>
    <text>文件</text>
  </view>
  <view class="nav-item {{selected === 2 ? 'nav-item-active' : ''}}" data-key="profile" bindtap="onTabTap">
    <image class="nav-icon" src="/assets/icons/nav-profile{{selected === 2 ? (theme === 'dark' ? '-active-dark' : '-active') : ''}}.svg"></image>
    <text>个人</text>
  </view>
</view>
