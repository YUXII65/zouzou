.app-header {
  position: fixed;
  z-index: 40;
  top: 0;
  right: 0;
  left: 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.62);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
}

.app-header-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 96rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.app-brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #2f63e6;
  box-shadow: 0 10rpx 24rpx rgba(47, 99, 230, 0.2);
}

.app-brand-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 6rpx solid #ffffff;
  border-right: 6rpx solid #ffffff;
  transform: rotate(45deg) translate(-3rpx, 3rpx);
}

.app-brand-title {
  color: #182238;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.app-header.theme-dark {
  border-bottom-color: #2d3a49;
  background: rgba(24, 33, 43, 0.78);
}

.theme-dark .app-brand-mark {
  background: #6d9bff;
}

.theme-dark .app-brand-title {
  color: #f2f5f9;
}
