.page { min-height: 100vh; background: linear-gradient(160deg, #e9f3ff 0%, #f6faff 50%, #eaf8fa 100%); }
.content { padding-right: 32rpx; padding-bottom: 64rpx; padding-left: 32rpx; box-sizing: border-box; }
.topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 48rpx; }
.brand-block { display: flex; align-items: center; gap: 18rpx; }
.brand-mark { display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; border-radius: 16rpx; background: #2f63e6; box-shadow: 0 10rpx 24rpx rgba(47,99,230,.2); }
.brand-arrow { width: 20rpx; height: 20rpx; border-top: 7rpx solid #fff; border-right: 7rpx solid #fff; transform: rotate(45deg) translate(-3rpx, 3rpx); }
.brand-title { display: block; color: #182238; font-size: 32rpx; font-weight: 600; }
.brand-subtitle { display: block; margin-top: 4rpx; color: #7e93ae; font-size: 24rpx; }
.skip { display: flex; height: 72rpx; align-items: center; justify-content: center; padding: 0 24rpx; border: 1rpx solid rgba(255,255,255,.85); border-radius: 16rpx; background: rgba(255,255,255,.72); color: #4d6d94; font-size: 28rpx; font-weight: 500; }
.step-tabs { display: flex; gap: 12rpx; margin-bottom: 24rpx; }
.step-tab { display: flex; flex: 1; min-width: 0; align-items: center; justify-content: center; gap: 8rpx; padding: 20rpx 8rpx; border-radius: 16rpx; background: #edf4fb; color: #7e93ae; font-size: 24rpx; font-weight: 500; }
.step-tab-active { background: #e8f0ff; color: #1e45b4; }
.step-dot { display: flex; width: 30rpx; height: 30rpx; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.8); font-size: 18rpx; }
.step-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.guide-card { padding: 48rpx; border: 1rpx solid rgba(255,255,255,.88); border-radius: 24rpx; background: rgba(255,255,255,.72); box-shadow: 0 24rpx 70rpx rgba(52,92,160,.12); backdrop-filter: blur(18px); }
.step-title { color: #182238; font-size: 32rpx; font-weight: 600; }
.guide-textarea { width: 100%; min-height: 220rpx; margin-top: 24rpx; padding: 24rpx 28rpx; box-sizing: border-box; border: 1rpx solid #dce8f7; border-radius: 16rpx; background: #fff; color: #182238; font-size: 30rpx; line-height: 1.7; }
.sample-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 20rpx; }
.sample-chip { padding: 16rpx 24rpx; border: 1rpx solid rgba(255,255,255,.85); border-radius: 16rpx; background: rgba(255,255,255,.72); color: #4d6d94; font-size: 24rpx; line-height: 1.5; }
.refresh-row { display: flex; justify-content: flex-start; margin-top: 16rpx; }
.refresh-button { display: flex; height: 64rpx; align-items: center; padding: 0 20rpx; border: 1rpx solid rgba(255,255,255,.85); border-radius: 12rpx; background: rgba(255,255,255,.72); color: #4d6d94; font-size: 24rpx; }
.action-row { display: flex; justify-content: flex-end; margin-top: 32rpx; }
.primary-action { display: inline-flex; min-height: 80rpx; align-items: center; justify-content: center; padding: 0 32rpx; border-radius: 16rpx; background: #2f63e6; color: #fff; font-size: 28rpx; font-weight: 500; }
.action-disabled { opacity: .5; }

.chat-list { margin-top: 24rpx; }
.chat-turn { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 18rpx; }
.chat-turn-user { justify-content: flex-end; }
.chat-avatar { display: flex; width: 48rpx; height: 48rpx; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 10rpx; background: #e8f0ff; color: #2f63e6; font-size: 24rpx; }
.chat-bubble { max-width: 78%; padding: 18rpx 24rpx; border-radius: 18rpx; font-size: 28rpx; line-height: 1.6; white-space: pre-wrap; }
.chat-bubble-user { border: 1rpx solid #dce8f7; border-top-right-radius: 6rpx; background: #f1f5f9; color: #182238; }
.chat-bubble-ai { border: 1rpx solid #e3ecf7; border-top-left-radius: 6rpx; background: #fff; color: #182238; }
.chat-options { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 12rpx; }
.chat-option { padding: 16rpx 24rpx; border: 1rpx solid rgba(255,255,255,.88); border-radius: 16rpx; background: #edf4fb; color: #4d6d94; font-size: 26rpx; line-height: 1.3; }
.chat-option-selected { border: 2rpx solid #2f63e6; background: #e8f0ff; color: #1e45b4; font-weight: 500; }
.chat-direct-toggle { color: #4d6d94; }
.multi-row { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; color: #7e93ae; font-size: 22rpx; }
.multi-confirm { display: flex; height: 64rpx; align-items: center; padding: 0 24rpx; border-radius: 12rpx; background: #2f63e6; color: #fff; font-size: 24rpx; }
.direct-row { display: flex; gap: 12rpx; margin-top: 16rpx; }
.direct-input { flex: 1; height: 72rpx; padding: 0 20rpx; border: 1rpx solid #dce8f7; border-radius: 16rpx; background: #fff; font-size: 26rpx; }
.direct-send { display: flex; height: 72rpx; align-items: center; padding: 0 24rpx; border-radius: 16rpx; background: #2f63e6; color: #fff; font-size: 24rpx; }
.thinking { display: flex; align-items: center; gap: 12rpx; margin-top: 20rpx; color: #4d6d94; font-size: 26rpx; }
.spinner { color: #2f63e6; font-size: 30rpx; animation: spin 1s linear infinite; }
.chat-done { margin-top: 20rpx; color: #4d6d94; font-size: 26rpx; line-height: 1.6; }
.warning-note { margin-top: 16rpx; padding: 16rpx 20rpx; border: 1rpx solid rgba(212,134,43,.25); border-radius: 12rpx; background: rgba(212,134,43,.08); color: #d4862b; font-size: 24rpx; line-height: 1.6; }
.source-card { margin-top: 20rpx; padding: 18rpx 22rpx; border-radius: 14rpx; background: rgba(232,240,255,.6); color: #1e45b4; font-size: 24rpx; line-height: 1.6; }
.field { margin-top: 24rpx; }
.field-label { display: block; margin-bottom: 12rpx; color: #4d6d94; font-size: 24rpx; font-weight: 500; }
.field-input, .field-textarea { width: 100%; padding: 18rpx 22rpx; box-sizing: border-box; border: 1rpx solid #dce8f7; border-radius: 16rpx; background: #fff; color: #182238; font-size: 28rpx; line-height: 1.6; }
.field-input { height: 76rpx; }
.field-textarea { min-height: 220rpx; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
