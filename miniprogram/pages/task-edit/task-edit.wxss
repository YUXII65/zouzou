.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; background: #edf4fb; }
.form-card { padding: 28rpx; border-radius: 24rpx; background: #ffffff; box-shadow: 0 18rpx 50rpx rgba(52, 92, 160, 0.1); }
.label { display: block; margin: 24rpx 0 10rpx; color: #4d6d94; font-size: 23rpx; }
.label:first-child { margin-top: 0; }
.input, .textarea, .picker { width: 100%; padding: 18rpx 20rpx; box-sizing: border-box; border-radius: 14rpx; background: #edf4fb; color: #182238; font-size: 26rpx; }
.textarea { min-height: 180rpx; }
.save-button { display: flex; align-items: center; justify-content: center; height: 84rpx; margin-top: 34rpx; border-radius: 16rpx; background: #2f63e6; color: #ffffff; font-size: 26rpx; font-weight: 600; }
.delete-button { display: flex; align-items: center; justify-content: center; height: 80rpx; margin-top: 18rpx; border-radius: 16rpx; background: rgba(217, 80, 80, 0.1); color: #d95050; font-size: 25rpx; font-weight: 600; }