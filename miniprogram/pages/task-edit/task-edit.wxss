.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; background: #edf4fb; }
.form-card { padding: 28rpx; border-radius: 24rpx; background: #ffffff; box-shadow: 0 18rpx 50rpx rgba(52, 92, 160, 0.1); }
.label { display: block; margin: 24rpx 0 10rpx; color: #4d6d94; font-size: 23rpx; }
.label:first-child { margin-top: 0; }
.input, .textarea, .picker { width: 100%; padding: 18rpx 20rpx; box-sizing: border-box; border-radius: 14rpx; background: #edf4fb; color: #182238; font-size: 26rpx; }
.textarea { min-height: 180rpx; }
.save-button { display: flex; align-items: center; justify-content: center; height: 84rpx; margin-top: 34rpx; border-radius: 16rpx; background: #2f63e6; color: #ffffff; font-size: 26rpx; font-weight: 600; }
.delete-button { display: flex; align-items: center; justify-content: center; height: 80rpx; margin-top: 18rpx; border-radius: 16rpx; background: rgba(217, 80, 80, 0.1); color: #d95050; font-size: 25rpx; font-weight: 600; }.sticky-section { margin-top: 36rpx; padding-top: 28rpx; border-top: 1rpx solid #e5eefb; }
.sticky-card { margin-bottom: 16rpx; padding: 20rpx; border-radius: 16rpx; background: rgba(212, 134, 43, 0.08); }
.sticky-head { display: flex; justify-content: space-between; gap: 12rpx; }
.sticky-title { color: #182238; font-size: 25rpx; font-weight: 700; }
.sticky-delete { color: #d95050; font-size: 22rpx; }
.sticky-copy { display: block; margin-top: 10rpx; color: #4d6d94; font-size: 23rpx; line-height: 1.6; }
.sticky-step { margin-top: 8rpx; color: #182238; font-size: 24rpx; line-height: 1.6; }
.sticky-next { margin-top: 12rpx; padding: 12rpx; border-radius: 12rpx; background: rgba(255,255,255,0.7); color: #182238; font-size: 23rpx; line-height: 1.6; }
.sticky-button { display: flex; align-items: center; justify-content: center; height: 78rpx; margin-top: 16rpx; border-radius: 14rpx; background: #0faec8; color: #ffffff; font-size: 25rpx; font-weight: 600; }

.ai-help { margin-top: 30rpx; padding: 20rpx; border-radius: 16rpx; background: rgba(232, 240, 255, 0.58); }
.ai-textarea { min-height: 120rpx; background: #ffffff; }
.ai-button, .ai-apply { display: flex; align-items: center; justify-content: center; height: 72rpx; margin-top: 14rpx; border-radius: 14rpx; background: #ffffff; color: #1e45b4; font-size: 23rpx; font-weight: 600; }
.ai-button-disabled { opacity: 0.55; }
.ai-suggestion { margin-top: 16rpx; padding: 16rpx; border-radius: 14rpx; background: #ffffff; }
.ai-reason { display: block; color: #4d6d94; font-size: 23rpx; line-height: 1.6; }
.ai-apply { height: 64rpx; background: #2f63e6; color: #ffffff; }
.sticky-toggle { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; padding: 18rpx 20rpx; border: 1rpx solid #dce8f7; border-radius: 14rpx; background: #ffffff; color: #4d6d94; font-size: 24rpx; font-weight: 600; }
.sticky-section { margin-top: 14rpx; padding-top: 0; border-top: 0; }
.sticky-empty { margin-bottom: 16rpx; color: #8296b0; font-size: 23rpx; line-height: 1.6; }