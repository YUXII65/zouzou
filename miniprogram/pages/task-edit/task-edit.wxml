<view class="page">
  <view class="form-card">
    <text class="label">标题</text>
    <input class="input" value="{{title}}" placeholder="一个清晰、可执行的动作" bindinput="onTitleInput" />

    <text class="label">内容</text>
    <textarea class="textarea" value="{{notes}}" placeholder="这件事具体是什么" bindinput="onNotesInput"></textarea>

    <text class="label">执行</text>
    <textarea class="textarea" value="{{doneWhen}}" placeholder="完成到什么程度算这一步结束" bindinput="onDoneWhenInput"></textarea>

    <text class="label">优先级</text>
    <picker mode="selector" range="{{priorityLabels}}" value="{{priorityIndex}}" bindchange="onPriorityChange">
      <view class="picker">{{priorityLabels[priorityIndex]}}</view>
    </picker>

    <text class="label">截止日期</text>
    <picker mode="date" value="{{dueDate}}" bindchange="onDueChange">
      <view class="picker">{{dueDate || '未设置'}}</view>
    </picker>

    <view class="sticky-toggle" bindtap="onToggleSticky">
      <text>便利贴（{{stickyNotes.length}} / 10）</text>
      <text>{{showSticky ? '收起' : '展开'}}</text>
    </view>

    <view class="sticky-section" wx:if="{{showSticky}}">
      <view class="sticky-card" wx:for="{{stickyNotes}}" wx:key="id">
        <view class="sticky-head">
          <text class="sticky-title">{{item.title}}</text>
          <text class="sticky-delete" data-id="{{item.id}}" bindtap="onDeleteSticky">删除</text>
        </view>
        <text class="sticky-copy">{{item.encouragement}}</text>
        <view class="sticky-step" wx:for="{{item.steps}}" wx:key="*this" wx:for-item="step">• {{step}}</view>
        <view class="sticky-next">现在可以做：{{item.nextStep}}</view>
      </view>
      <view class="sticky-empty" wx:if="{{stickyNotes.length === 0}}">还没有便利贴。写下你的想法后，AI 会生成详细执行步骤。</view>
      <input class="input" placeholder="你有什么想法补充" value="{{stickyMessage}}" bindinput="onStickyInput" />
      <view class="sticky-button" bindtap="onGenerateSticky">生成便利贴</view>
    </view>

    <view class="save-button" bindtap="onSave">保存任务</view>
    <view class="delete-button" bindtap="onDelete">删除任务</view>
  </view>
</view>