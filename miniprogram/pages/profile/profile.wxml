<view class="page theme-{{theme}}">
  <app-header theme="{{theme}}"></app-header>
  <canvas type="2d" id="avatar-canvas" class="avatar-canvas"></canvas>

  <view class="content" style="padding-top: {{contentTop}}px;">
    <view class="name-card">
      <view class="card-head">
        <view class="avatar" bindtap="onChooseAvatar">
          <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill"></image>
          <text wx:else>{{displayInitial}}</text>
        </view>

        <view class="name-main">
          <input
            wx:if="{{editingName}}"
            class="name-input"
            value="{{displayName}}"
            maxlength="24"
            focus="{{editingName}}"
            confirm-type="done"
            bindinput="onNameInput"
            bindconfirm="onSaveName"
          />
          <text wx:else class="name-text">{{displayName}}</text>
        </view>

        <view class="name-actions">
          <block wx:if="{{editingName}}">
            <view class="icon-button" bindtap="onCancelEditName">×</view>
            <view class="icon-button icon-button-primary" bindtap="onSaveName">{{saving ? '…' : '✓'}}</view>
          </block>
          <view wx:else class="icon-button" bindtap="onEditName">✎</view>
        </view>
      </view>

      <view class="mode-grid">
        <view class="mode-cell">
          <view class="mode-head">
            <view class="mode-dot mode-dot-normal"></view>
            <text class="mode-name">普通</text>
          </view>
          <text class="mode-count mode-count-normal">{{counts.normal}}</text>
          <text class="mode-caption">推进中</text>
        </view>
        <view class="mode-cell">
          <view class="mode-head">
            <view class="mode-dot mode-dot-longterm"></view>
            <text class="mode-name">长期</text>
          </view>
          <text class="mode-count mode-count-longterm">{{counts.longterm}}</text>
          <text class="mode-caption">推进中</text>
        </view>
        <view class="mode-cell">
          <view class="mode-head">
            <view class="mode-dot mode-dot-explore"></view>
            <text class="mode-name">探索</text>
          </view>
          <text class="mode-count mode-count-explore">{{counts.explore}}</text>
          <text class="mode-caption">推进中</text>
        </view>
      </view>
    </view>

    <view class="action-grid">
      <view class="action-button" bindtap="onThemeTap">
        <view class="action-main">
          <image class="action-icon" src="/assets/icons/moon.svg"></image>
          <text>夜间模式</text>
        </view>
        <view class="action-state {{theme === 'dark' ? 'action-state-on' : ''}}">
          <image wx:if="{{theme === 'dark'}}" class="action-state-icon" src="/assets/icons/check.svg"></image>
          <view wx:else class="action-state-circle"></view>
        </view>
      </view>
      <view class="action-button" bindtap="onApiSettings">
        <view class="action-main">
          <image class="action-icon" src="/assets/icons/key.svg"></image>
          <text>API 连接</text>
        </view>
        <view class="action-state {{serverConnected ? 'action-state-on' : 'action-state-warning'}}">
          <image wx:if="{{serverConnected}}" class="action-state-icon" src="/assets/icons/check.svg"></image>
          <view wx:else class="action-state-circle"></view>
        </view>
      </view>
      <view class="action-button" bindtap="onLogout">
        <view class="action-main">
          <image class="action-icon" src="/assets/icons/logout.svg"></image>
          <text>退出登录</text>
        </view>
      </view>
    </view>
    <site-footer theme="{{theme}}"></site-footer>
  </view>
</view>
