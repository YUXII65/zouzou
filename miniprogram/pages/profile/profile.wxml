<view class="page theme-{{theme}}">
  <app-header theme="{{theme}}"></app-header>
  <canvas type="2d" id="avatar-canvas" class="avatar-canvas"></canvas>

  <view class="content" style="padding-top: {{contentTop}}px;">
    <view class="name-card">
      <view class="card-head">
        <view class="avatar" bindtap="onChooseAvatar">
          <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill"></image>
          <text wx:else>{{displayInitial}}</text>
        </view>

        <view class="name-main">
          <input
            wx:if="{{editingName}}"
            class="name-input"
            value="{{displayName}}"
            maxlength="24"
            focus="{{editingName}}"
            confirm-type="done"
            bindinput="onNameInput"
            bindconfirm="onSaveName"
          />
          <text wx:else class="name-text">{{displayName}}</text>
        </view>

        <view class="name-actions">
          <block wx:if="{{editingName}}">
            <view class="icon-button" bindtap="onCancelEditName">×</view>
            <view class="icon-button icon-button-primary" bindtap="onSaveName">{{saving ? '…' : '✓'}}</view>
          </block>
          <view wx:else class="icon-button" bindtap="onEditName">✎</view>
        </view>
      </view>

      <view class="mode-grid">
        <view class="mode-cell">
          <view class="mode-head">
            <view class="mode-dot mode-dot-normal"></view>
            <text class="mode-name">普通</text>
          </view>
          <text class="mode-count mode-count-normal">{{counts.normal}}</text>
          <text class="mode-caption">推进中</text>
        </view>
        <view class="mode-cell">
          <view class="mode-head">
            <view class="mode-dot mode-dot-longterm"></view>
            <text class="mode-name">长期</text>
          </view>
          <text class="mode-count mode-count-longterm">{{counts.longterm}}</text>
          <text class="mode-caption">推进中</text>
        </view>
        <view class="mode-cell">
          <view class="mode-head">
            <view class="mode-dot mode-dot-explore"></view>
            <text class="mode-name">探索</text>
          </view>
          <text class="mode-count mode-count-explore">{{counts.explore}}</text>
          <text class="mode-caption">推进中</text>
        </view>
      </view>
    </view>

    <view class="action-grid">
      <view class="action-button checkin-entry {{checkin ? 'checkin-entry-on' : ''}}" bindtap="onCheckinModeTap">
        <view class="action-main">
          <image class="action-icon" src="/assets/icons/list.svg"></image>
          <text>打卡模式</text>
        </view>
        <view class="checkin-entry-state">
          <block wx:if="{{checkin}}">
            <text>第 {{checkin.dayNumber}} 天</text>
            <image class="action-state-icon" src="/assets/icons/check.svg"></image>
          </block>
          <text wx:else>开启</text>
        </view>
      </view>
      <view class="action-button" bindtap="onThemeTap">
        <view class="action-main">
          <image class="action-icon" src="/assets/icons/moon.svg"></image>
          <text>夜间模式</text>
        </view>
        <view class="action-state {{theme === 'dark' ? 'action-state-on' : ''}}">
          <image wx:if="{{theme === 'dark'}}" class="action-state-icon" src="/assets/icons/check.svg"></image>
          <view wx:else class="action-state-circle"></view>
        </view>
      </view>
      <view class="action-button" bindtap="onApiSettings">
        <view class="action-main">
          <image class="action-icon" src="/assets/icons/key.svg"></image>
          <text>API 连接</text>
        </view>
        <view class="action-state {{serverConnected ? 'action-state-on' : 'action-state-warning'}}">
          <image wx:if="{{serverConnected}}" class="action-state-icon" src="/assets/icons/check.svg"></image>
          <view wx:else class="action-state-circle"></view>
        </view>
      </view>
      <view class="action-button" bindtap="onLogout">
        <view class="action-main">
          <image class="action-icon" src="/assets/icons/logout.svg"></image>
          <text>退出登录</text>
        </view>
      </view>
    </view>
    <view class="checkin-mask" wx:if="{{checkinDialog}}" bindtap="onCheckinClose">
      <view class="checkin-dialog" catchtap="stopPropagation">
        <view class="checkin-dialog-head">
          <view>
            <text class="checkin-dialog-title">{{checkinDialogMode === 'edit' ? '编辑打卡内容' : '开启打卡模式'}}</text>
            <text class="checkin-dialog-copy">{{checkinDialogMode === 'edit' ? '改完后会更新每天显示的清单' : '监督待办，培养习惯'}}</text>
          </view>
          <view class="checkin-dialog-close" bindtap="onCheckinClose">×</view>
        </view>
        <view class="checkin-field-list">
          <view
            class="checkin-item-row"
            wx:for="{{checkinItems}}"
            wx:key="index"
            wx:for-index="index"
          >
            <input
              class="checkin-item-input"
              value="{{item.value}}"
              maxlength="80"
              placeholder="{{item.added ? '添加' : '待办 ' + item.label}}"
              data-index="{{index}}"
              bindinput="onCheckinInput"
            />
            <view class="checkin-item-cancel" wx:if="{{item.value || item.added}}" data-index="{{index}}" bindtap="onRemoveCheckinItem">取消</view>
          </view>
          <view class="checkin-plus" wx:if="{{checkinItems.length < 30}}" bindtap="onAddCheckinItem">＋</view>
        </view>
        <view class="checkin-dialog-actions">
          <view wx:if="{{checkinDialogMode === 'edit'}}" class="checkin-remove" bindtap="onCheckinRemoveFromEdit">取消打卡</view>
          <view class="checkin-cancel" bindtap="onCheckinClose">取消</view>
          <view class="checkin-confirm {{checkinSaving ? 'checkin-confirm-disabled' : ''}}" bindtap="onCheckinConfirm">{{checkinSaving ? '正在保存…' : checkinDialogMode === 'edit' ? '保存' : '确认开启'}}</view>
        </view>
      </view>
    </view>
    <site-footer theme="{{theme}}"></site-footer>
  </view>
</view>
