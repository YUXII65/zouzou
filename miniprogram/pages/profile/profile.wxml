<view class="page">
  <view class="profile-card">
    <view class="avatar" bindtap="onChooseAvatar"><image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill"></image><text wx:else>{{(displayName || username || '走').slice(0, 1)}}</text></view>
    <text class="username">@{{username}}</text>
    <text class="label">显示名称</text>
    <input class="input" value="{{displayName}}" placeholder="设置展示名称" bindinput="onNameInput" />
    <view class="save-button" bindtap="onSave">保存资料</view>
    <view class="logout-button" bindtap="onLogout">退出登录</view>
  </view>
</view>