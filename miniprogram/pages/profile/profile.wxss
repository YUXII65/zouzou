.page {
  min-height: 100vh;
  padding-right: 32rpx;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  padding-left: 32rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #e9f3ff 0%, #f6faff 50%, #eaf8fa 100%);
}

.content {
  width: 100%;
}

.name-card {
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(18px);
}

.card-head {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 48rpx;
}

.avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #e8f0ff;
  color: #1e45b4;
  font-size: 48rpx;
  font-weight: 600;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.name-main {
  flex: 1;
  min-width: 0;
}

.name-text {
  display: block;
  overflow: hidden;
  color: #182238;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.name-input {
  width: 100%;
  height: 76rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border: 1rpx solid #dce8f7;
  border-radius: 16rpx;
  background: #ffffff;
  color: #182238;
  font-size: 34rpx;
  font-weight: 600;
}

.name-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 10rpx;
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  color: #7e93ae;
  font-size: 34rpx;
  line-height: 1;
}

.icon-button-primary {
  background: #2f63e6;
  color: #ffffff;
}

.mode-grid {
  display: flex;
  border-top: 1rpx solid rgba(220, 232, 247, 0.9);
}

.mode-cell {
  flex: 1;
  min-width: 0;
  padding: 40rpx 12rpx;
  text-align: center;
}

.mode-cell + .mode-cell {
  border-left: 1rpx solid rgba(220, 232, 247, 0.9);
}

.mode-head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.mode-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.mode-dot-normal {
  background: #4a9ae8;
}

.mode-dot-longterm {
  background: #1e3f9c;
}

.mode-dot-explore {
  background: #7b4fd6;
}

.mode-name {
  color: #4d6d94;
  font-size: 24rpx;
  font-weight: 500;
}

.mode-count {
  display: block;
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.1;
}

.mode-count-normal {
  color: #1667b8;
}

.mode-count-longterm {
  color: #1a3480;
}

.mode-count-explore {
  color: #5f31b8;
}

.mode-caption {
  display: block;
  margin-top: 8rpx;
  color: #7e93ae;
  font-size: 22rpx;
}

.checkin-entry {
  color: #4d6d94;
}

.checkin-entry-on {
  border-color: rgba(22, 163, 163, 0.34);
  background: rgba(223, 248, 245, 0.82);
  color: #087b7b;
}

.checkin-entry-state {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 6rpx;
  font-size: 21rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

@media (orientation: landscape) {
  .action-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

.action-button {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  height: 80rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #4d6d94;
  font-size: 24rpx;
  font-weight: 500;
}

.action-main {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
}

.action-main text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-icon {
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
}

.action-state {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}

.action-state-icon {
  width: 28rpx;
  height: 28rpx;
}

.action-state-circle {
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #9aa9bb;
  border-radius: 50%;
  box-sizing: border-box;
}

.action-state-warning .action-state-circle {
  border-color: #d4862b;
}

.avatar-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 192px;
  height: 192px;
}

.checkin-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(24, 34, 56, 0.38);
}

.checkin-dialog {
  width: 100%;
  padding: 32rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 90rpx rgba(32, 62, 105, 0.24);
}

.checkin-dialog-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.checkin-dialog-title,
.checkin-dialog-copy {
  display: block;
}

.checkin-dialog-title {
  color: #182238;
  font-size: 30rpx;
  font-weight: 600;
}

.checkin-dialog-copy {
  margin-top: 8rpx;
  color: #7e93ae;
  font-size: 21rpx;
}

.checkin-dialog-close {
  color: #7e93ae;
  font-size: 36rpx;
  line-height: 1;
}

.checkin-field-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 24rpx;
}

.checkin-item-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #dce8f7;
  border-radius: 14rpx;
  background: #f7faff;
  color: #182238;
  font-size: 24rpx;
}

.checkin-item-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.checkin-item-cancel {
  flex-shrink: 0;
  padding: 10rpx 8rpx;
  color: #7e93ae;
  font-size: 22rpx;
}

.checkin-plus {
  display: flex;
  width: 60rpx;
  height: 60rpx;
  align-items: center;
  align-self: flex-start;
  justify-content: center;
  border: 1rpx solid rgba(22, 163, 163, 0.2);
  border-radius: 12rpx;
  background: rgba(223, 248, 245, 0.55);
  color: #087b7b;
  font-size: 34rpx;
  font-weight: 500;
}

.checkin-dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

.checkin-cancel,
.checkin-remove,
.checkin-confirm {
  display: flex;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.checkin-remove {
  margin-right: auto;
  color: #c54747;
}

.checkin-cancel {
  color: #7e93ae;
}

.checkin-confirm {
  background: #16a3a3;
  color: #ffffff;
  font-weight: 600;
}

.checkin-confirm-disabled {
  opacity: 0.55;
}
