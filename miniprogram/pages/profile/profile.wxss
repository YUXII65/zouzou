.page { min-height: 100vh; padding: 32rpx 28rpx; box-sizing: border-box; background: #edf4fb; }
.profile-card { padding: 40rpx 30rpx; border-radius: 26rpx; background: #ffffff; box-shadow: 0 18rpx 50rpx rgba(52, 92, 160, 0.1); text-align: center; }
.avatar { display: flex; align-items: center; justify-content: center; width: 128rpx; height: 128rpx; margin: 0 auto; overflow: hidden; border-radius: 50%; background: #e8f0ff; color: #1e45b4; font-size: 48rpx; font-weight: 700; }
.avatar image { width: 100%; height: 100%; }
.username { display: block; margin-top: 20rpx; color: #8296b0; font-size: 23rpx; }
.label { display: block; margin-top: 42rpx; color: #4d6d94; font-size: 23rpx; text-align: left; }
.input { width: 100%; height: 84rpx; margin-top: 12rpx; padding: 0 22rpx; box-sizing: border-box; border-radius: 16rpx; background: #edf4fb; color: #182238; font-size: 27rpx; text-align: left; }
.save-button { display: flex; align-items: center; justify-content: center; height: 84rpx; margin-top: 28rpx; border-radius: 16rpx; background: #2f63e6; color: #ffffff; font-size: 26rpx; font-weight: 600; }
.logout-button { display: flex; align-items: center; justify-content: center; height: 80rpx; margin-top: 18rpx; border-radius: 16rpx; background: rgba(217, 80, 80, 0.1); color: #d95050; font-size: 25rpx; font-weight: 600; }
.avatar-canvas { position: fixed; left: -9999px; top: -9999px; width: 192px; height: 192px; }
.reset-avatar { display: inline-block; margin-top: 12rpx; color: #8296b0; font-size: 22rpx; }
.save-button-disabled { opacity: 0.6; }