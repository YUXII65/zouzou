.page {
  min-height: 100vh;
  padding-bottom: 130rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #e9f3ff 0%, #f6faff 50%, #eaf8fa 100%);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.72);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.85);
}

.brand-row,
.top-actions {
  display: flex;
  align-items: center;
}

.brand-row {
  gap: 14rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: #2f63e6;
}

.brand-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 6rpx solid #ffffff;
  border-right: 6rpx solid #ffffff;
  transform: rotate(45deg) translate(-3rpx, 3rpx);
}

.brand-name {
  color: #182238;
  font-size: 28rpx;
  font-weight: 600;
}

.top-actions {
  gap: 16rpx;
}

.top-icon,
.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #4d6d94;
  font-size: 28rpx;
}

.avatar {
  background: #e8f0ff;
  color: #1e45b4;
  font-weight: 700;
}

.content {
  padding: 24rpx 24rpx 40rpx;
}

.panel {
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 18rpx 50rpx rgba(52, 92, 160, 0.1);
}

.date-panel {
  padding: 26rpx;
}

.date-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 20rpx;
}

.date-main {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.date-number {
  color: #182238;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.date-text,
.clock {
  color: #4d6d94;
  font-size: 28rpx;
  font-weight: 600;
}

.date-progress {
  width: 100%;
  margin-top: 18rpx;
}

.progress-copy {
  display: flex;
  justify-content: space-between;
  color: #4d6d94;
  font-size: 23rpx;
}

.progress-track {
  height: 12rpx;
  margin-top: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf4fb;
}

.progress-fill {
  width: 0;
  height: 100%;
  border-radius: 999rpx;
  background: #2f63e6;
}

.streak-pill {
  display: inline-block;
  margin-top: 20rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(212, 134, 43, 0.12);
  color: #d4862b;
  font-size: 23rpx;
  font-weight: 600;
}

.capture-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(47, 99, 230, 0.15);
  border-radius: 24rpx;
  background: linear-gradient(145deg, rgba(232, 240, 255, 0.88), rgba(255, 255, 255, 0.9) 52%, rgba(229, 248, 251, 0.78));
  box-shadow: 0 18rpx 50rpx rgba(52, 92, 160, 0.1);
}

.capture-input {
  width: 100%;
  min-height: 220rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #182238;
  font-size: 30rpx;
  line-height: 1.6;
}

.capture-placeholder {
  color: #8296b0;
}

.sample-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.sample-chip {
  max-width: 100%;
  padding: 10rpx 18rpx;
  border: 1rpx solid #dce8f7;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #4d6d94;
  font-size: 23rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.capture-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}

.refresh-button {
  padding: 14rpx 20rpx;
  border: 1rpx solid #dce8f7;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #4d6d94;
  font-size: 24rpx;
}

.next-button {
  padding: 16rpx 28rpx;
  border-radius: 14rpx;
  background: #2f63e6;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(47, 99, 230, 0.2);
}

.tasks-panel {
  margin-top: 24rpx;
  overflow: hidden;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid rgba(220, 232, 247, 0.8);
}

.panel-title {
  color: #182238;
  font-size: 30rpx;
  font-weight: 700;
}

.panel-count {
  color: #8296b0;
  font-size: 23rpx;
}

.empty-state {
  padding: 46rpx 30rpx 40rpx;
  text-align: center;
}

.empty-icon {
  color: #2f63e6;
  font-size: 44rpx;
}

.empty-title {
  margin-top: 16rpx;
  color: #182238;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-hint {
  margin-top: 10rpx;
  color: #4d6d94;
  font-size: 25rpx;
  line-height: 1.65;
}

.empty-action {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
  background: #2f63e6;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
}

.review-link {
  margin-top: 24rpx;
  color: #4d6d94;
  font-size: 25rpx;
  text-align: right;
}

.bottom-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.9);
  border-top: 1rpx solid rgba(220, 232, 247, 0.9);
}

.nav-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #8296b0;
  font-size: 22rpx;
}

.nav-item-active {
  color: #2f63e6;
  font-weight: 600;
}

.nav-icon {
  font-size: 32rpx;
  line-height: 1;
}.pending-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 24rpx; }
.pending-card { padding: 24rpx; border: 1rpx solid rgba(47, 99, 230, 0.15); border-radius: 20rpx; background: rgba(255, 255, 255, 0.84); box-shadow: 0 14rpx 36rpx rgba(52, 92, 160, 0.08); }
.pending-content { color: #182238; font-size: 26rpx; line-height: 1.6; }
.pending-action { display: inline-block; margin-top: 12rpx; padding: 6rpx 12rpx; border-radius: 8rpx; background: #e8f0ff; color: #1e45b4; font-size: 21rpx; }
.pending-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.pending-option { padding: 10rpx 16rpx; border: 1rpx solid #dce8f7; border-radius: 12rpx; color: #4d6d94; font-size: 23rpx; }
.pending-plan { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #e5eefb; }
.pending-plan-row { color: #182238; font-size: 24rpx; line-height: 1.6; }
.pending-plan-row + .pending-plan-row { margin-top: 10rpx; }
.pending-confirm { display: inline-block; margin-top: 16rpx; padding: 12rpx 20rpx; border-radius: 12rpx; background: #2f63e6; color: #ffffff; font-size: 23rpx; font-weight: 600; }
.task-row { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 26rpx; border-bottom: 1rpx solid #eef3f9; }
.task-copy { flex: 1; min-width: 0; }
.task-action { flex-shrink: 0; padding: 10rpx 16rpx; border-radius: 12rpx; background: #e8f0ff; color: #1e45b4; font-size: 22rpx; font-weight: 600; }
