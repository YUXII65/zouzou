.page {
  min-height: 100vh;
  padding-bottom: 130rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #e9f3ff 0%, #f6faff 50%, #eaf8fa 100%);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.72);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.85);
}

.brand-row,
.top-actions {
  display: flex;
  align-items: center;
}

.brand-row {
  gap: 14rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: #2f63e6;
}

.brand-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 6rpx solid #ffffff;
  border-right: 6rpx solid #ffffff;
  transform: rotate(45deg) translate(-3rpx, 3rpx);
}

.brand-name {
  color: #182238;
  font-size: 28rpx;
  font-weight: 600;
}

.top-actions {
  gap: 16rpx;
}

.top-icon,
.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #4d6d94;
  font-size: 28rpx;
}

.avatar {
  background: #e8f0ff;
  color: #1e45b4;
  font-weight: 700;
}

.content {
  padding-top: calc(env(safe-area-inset-top) + 128rpx);
  padding-right: 24rpx;
  padding-bottom: 40rpx;
  padding-left: 24rpx;
}

.panel {
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 18rpx 50rpx rgba(52, 92, 160, 0.1);
}

.capture-card {
  margin-top: 0;
  padding: 28rpx;
  border: 1rpx solid rgba(47, 99, 230, 0.15);
  border-radius: 24rpx;
  background: linear-gradient(145deg, rgba(232, 240, 255, 0.88), rgba(255, 255, 255, 0.9) 52%, rgba(229, 248, 251, 0.78));
  box-shadow: 0 18rpx 50rpx rgba(52, 92, 160, 0.1);
}

.capture-input {
  width: 100%;
  min-height: 220rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #182238;
  font-size: 30rpx;
  line-height: 1.6;
}

.capture-placeholder {
  color: #8296b0;
}

.sample-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 16rpx;
}

.sample-chip {
  width: 100%;
  padding: 14rpx 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #dce8f7;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #4d6d94;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.capture-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 8rpx;
}

.sample-refresh-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.refresh-button {
  padding: 14rpx 20rpx;
  border: 1rpx solid #dce8f7;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #4d6d94;
  font-size: 24rpx;
}

.next-button {
  padding: 16rpx 28rpx;
  border-radius: 14rpx;
  background: #2f63e6;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(47, 99, 230, 0.2);
}

.tasks-panel {
  margin-top: 24rpx;
  overflow: hidden;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid rgba(220, 232, 247, 0.8);
}

.panel-title {
  color: #182238;
  font-size: 30rpx;
  font-weight: 700;
}

.panel-count {
  color: #8296b0;
  font-size: 23rpx;
}

.empty-state {
  padding: 46rpx 30rpx 40rpx;
  text-align: center;
}

.empty-icon {
  color: #2f63e6;
  font-size: 44rpx;
}

.empty-title {
  margin-top: 16rpx;
  color: #182238;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-hint {
  margin-top: 10rpx;
  color: #4d6d94;
  font-size: 25rpx;
  line-height: 1.65;
}

.empty-action {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
  background: #2f63e6;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
}

.review-link {
  margin-top: 24rpx;
  color: #4d6d94;
  font-size: 25rpx;
  text-align: right;
}

.pending-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 24rpx; }
.pending-card { padding: 24rpx; border: 1rpx solid rgba(47, 99, 230, 0.15); border-radius: 20rpx; background: rgba(255, 255, 255, 0.84); box-shadow: 0 14rpx 36rpx rgba(52, 92, 160, 0.08); }
.pending-content { color: #182238; font-size: 26rpx; line-height: 1.6; }
.pending-action { display: inline-block; margin-top: 12rpx; padding: 6rpx 12rpx; border-radius: 8rpx; background: #e8f0ff; color: #1e45b4; font-size: 21rpx; }
.pending-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.pending-option { padding: 10rpx 16rpx; border: 1rpx solid #dce8f7; border-radius: 12rpx; color: #4d6d94; font-size: 23rpx; }
.pending-plan { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #e5eefb; }
.pending-plan-row { color: #182238; font-size: 24rpx; line-height: 1.6; }
.pending-plan-row + .pending-plan-row { margin-top: 10rpx; }
.pending-confirm { display: inline-block; margin-top: 16rpx; padding: 12rpx 20rpx; border-radius: 12rpx; background: #2f63e6; color: #ffffff; font-size: 23rpx; font-weight: 600; }
.task-row { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 26rpx; border-bottom: 1rpx solid #eef3f9; }
.task-copy { flex: 1; min-width: 0; }
.task-action { flex-shrink: 0; padding: 10rpx 16rpx; border-radius: 12rpx; background: #e8f0ff; color: #1e45b4; font-size: 22rpx; font-weight: 600; }

/* AI 计划编辑：与网页端 InboxPlanEditor 对齐 */
.pending-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.pending-head .pending-content { flex: 1; min-width: 0; padding: 0; border: 0; background: transparent; font-size: 26rpx; line-height: 1.6; }
.pending-head .pending-action { flex-shrink: 0; margin-top: 2rpx; }
.pending-clarify { margin-top: 18rpx; }
.clarify-dimension + .clarify-dimension { margin-top: 18rpx; }
.clarify-question { color: #182238; font-size: 25rpx; font-weight: 600; line-height: 1.55; }
.clarify-supplement { width: 100%; min-height: 126rpx; margin-top: 18rpx; padding: 16rpx; box-sizing: border-box; border: 1rpx solid #dce8f7; border-radius: 14rpx; background: #ffffff; color: #182238; font-size: 24rpx; line-height: 1.55; }
.pending-option-selected { border-color: #2f63e6; background: #2f63e6; color: #ffffff; }
.pending-confirm { display: block; text-align: center; }
.pending-confirm-disabled { opacity: 0.55; }
.plan-project { margin-top: 16rpx; padding: 18rpx; border: 1rpx solid rgba(47, 99, 230, 0.16); border-radius: 16rpx; background: rgba(232, 240, 255, 0.62); }
.plan-task { margin-top: 18rpx; padding: 18rpx; border: 1rpx solid #e3ecf7; border-radius: 18rpx; background: rgba(255, 255, 255, 0.92); box-shadow: 0 10rpx 26rpx rgba(52, 92, 160, 0.05); }
.plan-task-head { display: flex; align-items: center; gap: 10rpx; }
.plan-task-number { display: flex; width: 36rpx; height: 36rpx; align-items: center; justify-content: center; border-radius: 10rpx; background: #2f63e6; color: #ffffff; font-size: 21rpx; line-height: 1; }
.plan-task-title { color: #182238; font-size: 25rpx; font-weight: 700; }
.plan-task-hint { margin-left: auto; color: #8296b0; font-size: 21rpx; }
.plan-field { margin-top: 14rpx; min-width: 0; }
.plan-label { display: block; margin-bottom: 8rpx; color: #4d6d94; font-size: 21rpx; font-weight: 600; }
.plan-input, .plan-textarea, .plan-picker-value { width: 100%; box-sizing: border-box; padding: 13rpx 15rpx; border: 1rpx solid #dce8f7; border-radius: 12rpx; background: #ffffff; color: #182238; font-size: 24rpx; line-height: 1.5; }
.plan-input { min-height: 70rpx; }
.plan-textarea { min-height: 104rpx; }
.plan-picker-value { min-height: 70rpx; }
.plan-grid { display: flex; gap: 12rpx; margin-top: 2rpx; }
.plan-grid .plan-field { flex: 1; min-width: 0; }
.plan-reason { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 18rpx; padding: 18rpx; border-radius: 14rpx; background: rgba(232, 240, 255, 0.66); color: #4d6d94; font-size: 23rpx; line-height: 1.65; }
.plan-reason-icon { flex-shrink: 0; color: #2f63e6; }
/* 今日任务行：对齐网页 AgendaTaskRow */
.task-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 8rpx; }
.task-tag { padding: 4rpx 10rpx; border-radius: 8rpx; font-size: 20rpx; line-height: 1.3; }
.task-tag-focus { background: #e8f0ff; color: #1e45b4; }
.task-tag-overdue { background: rgba(217, 80, 80, 0.1); color: #d95050; }
.task-tag-plan { background: #f1f5fa; color: #4d6d94; }
.task-meta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; margin-top: 7rpx; }
.task-meta { max-width: 62%; overflow: hidden; color: #9aa9bb; font-size: 19rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.task-priority { padding: 4rpx 10rpx; border-radius: 999rpx; background: #e8f0ff; color: #1e45b4; font-size: 20rpx; line-height: 1.3; }
.task-due { display: block; margin-top: 7rpx; color: #d95050; font-size: 21rpx; }
.pending-footer { display: flex; justify-content: flex-end; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #e5eefb; }
.pending-ignore { padding: 10rpx 16rpx; border: 1rpx solid #dce8f7; border-radius: 12rpx; background: #ffffff; color: #8296b0; font-size: 22rpx; }
.task-detail { margin-top: 12rpx; padding: 18rpx; border: 1rpx solid #e3ecf7; border-radius: 14rpx; background: #f7faff; }
.task-detail-title { color: #182238; font-size: 24rpx; line-height: 1.6; white-space: pre-wrap; }
.task-detail-copy { margin-top: 10rpx; padding-top: 10rpx; border-top: 1rpx solid #e5eefb; color: #4d6d94; font-size: 22rpx; line-height: 1.6; white-space: pre-wrap; }
.task-detail-standard { margin-top: 10rpx; padding-top: 10rpx; border-top: 1rpx solid #e5eefb; color: #4d6d94; font-size: 22rpx; line-height: 1.6; }
.task-detail-edit { display: inline-block; margin-top: 12rpx; color: #2f63e6; font-size: 22rpx; font-weight: 600; }