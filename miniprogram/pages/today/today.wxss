.page {
  min-height: 100vh;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(160deg, #e9f3ff 0%, #f6faff 50%, #eaf8fa 100%);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.72);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.85);
}

.brand-row,
.top-actions {
  display: flex;
  align-items: center;
}

.brand-row {
  gap: 14rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: #2f63e6;
}

.brand-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 6rpx solid #ffffff;
  border-right: 6rpx solid #ffffff;
  transform: rotate(45deg) translate(-3rpx, 3rpx);
}

.brand-name {
  color: #182238;
  font-size: 28rpx;
  font-weight: 600;
}

.top-actions {
  gap: 16rpx;
}

.top-icon,
.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #4d6d94;
  font-size: 28rpx;
}

.avatar {
  background: #e8f0ff;
  color: #1e45b4;
  font-weight: 700;
}

.content {
  padding-right: 32rpx;
  padding-bottom: 40rpx;
  padding-left: 32rpx;
}

.panel {
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 18rpx 50rpx rgba(52, 92, 160, 0.1);
}

.planner-card {
  padding: 32rpx;
  border: 1rpx solid rgba(47, 99, 230, 0.15);
  border-radius: 40rpx;
  background: linear-gradient(145deg, rgba(232, 240, 255, 0.88), rgba(255, 255, 255, 0.9) 52%, rgba(229, 248, 251, 0.78));
  box-shadow: 0 18rpx 50rpx rgba(52, 92, 160, 0.1);
}

.capture-card {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.capture-input {
  width: 100%;
  min-height: 352rpx;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #182238;
  font-size: 32rpx;
  line-height: 1.75;
}

.capture-placeholder {
  color: #8296b0;
}

.sample-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 24rpx;
}

.sample-chip {
  width: 100%;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #dce8f7;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #4d6d94;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.capture-actions {
  display: flex;
  align-items: center;
  justify-content: stretch;
  gap: 16rpx;
  margin-top: 16rpx;
}

.sample-refresh-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.refresh-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 20rpx;
  border: 0;
  border-radius: 12rpx;
  background: transparent;
  color: #7e93ae;
  font-size: 24rpx;
}

.next-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #2f63e6;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 12rpx 24rpx rgba(47, 99, 230, 0.2);
}

.tasks-panel {
  margin-top: 48rpx;
  overflow: hidden;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(220, 232, 247, 0.8);
}

.panel-heading {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 16rpx;
}

.panel-title-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.panel-title {
  overflow: hidden;
  color: #182238;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-count {
  color: #8296b0;
  font-size: 24rpx;
}

.empty-state {
  padding: 46rpx 30rpx 40rpx;
  text-align: center;
}

.empty-icon {
  color: #2f63e6;
  font-size: 44rpx;
}

.empty-title {
  margin-top: 16rpx;
  color: #182238;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-hint {
  margin-top: 10rpx;
  color: #4d6d94;
  font-size: 25rpx;
  line-height: 1.65;
}

.empty-action {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
  background: #2f63e6;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
}

.review-link {
  margin-top: 24rpx;
  color: #4d6d94;
  font-size: 25rpx;
  text-align: right;
}

.pending-list { display: flex; flex-direction: column; margin-top: 0; }
.pending-card { padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
.pending-card + .pending-card { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(220, 232, 247, 0.8); }
.pending-content { color: #182238; font-size: 26rpx; line-height: 1.6; }
.pending-action { display: inline-block; margin-top: 12rpx; padding: 6rpx 12rpx; border-radius: 8rpx; background: #e8f0ff; color: #1e45b4; font-size: 21rpx; }
.pending-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.pending-option { padding: 10rpx 16rpx; border: 1rpx solid #dce8f7; border-radius: 12rpx; color: #4d6d94; font-size: 23rpx; }
.pending-plan { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #e5eefb; }
.pending-plan-row { color: #182238; font-size: 24rpx; line-height: 1.6; }
.pending-plan-row + .pending-plan-row { margin-top: 10rpx; }
.pending-confirm { display: inline-block; margin-top: 16rpx; padding: 12rpx 20rpx; border-radius: 12rpx; background: #2f63e6; color: #ffffff; font-size: 23rpx; font-weight: 600; }
.task-row { display: flex; flex-direction: column; align-items: stretch; gap: 24rpx; padding: 24rpx 32rpx; border-bottom: 1rpx solid #eef3f9; }
.task-copy { min-width: 0; }
.task-action-row { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; }
.task-action { display: inline-flex; align-items: center; justify-content: center; gap: 6rpx; min-width: 144rpx; height: 64rpx; padding: 0 24rpx; box-sizing: border-box; border: 1rpx solid #dce8f7; border-radius: 16rpx; background: #f7faff; color: #4d6d94; font-size: 24rpx; font-weight: 500; }
.task-action-in_progress { border-color: #2f63e6; background: #e8f0ff; color: #1e45b4; }
.task-action-done { border-color: rgba(28, 157, 106, 0.3); background: rgba(28, 157, 106, 0.08); color: #1c9d6a; }
.task-action-icon { width: 28rpx; height: 28rpx; line-height: 1; }
.completed-divider { display: flex; align-items: center; gap: 6rpx; padding: 16rpx 32rpx; background: rgba(237, 244, 251, 0.72); color: #8296b0; font-size: 24rpx; font-weight: 500; }
.completed-check { color: #1c9d6a; }

/* AI 计划编辑：与网页端 InboxPlanEditor 对齐 */
.pending-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.pending-head .pending-content { flex: 1; min-width: 0; padding: 0; border: 0; background: transparent; font-size: 26rpx; line-height: 1.6; }
.pending-head .pending-action { flex-shrink: 0; margin-top: 2rpx; }
.pending-clarify { margin-top: 18rpx; }
.clarify-dimension + .clarify-dimension { margin-top: 18rpx; }
.clarify-question { color: #182238; font-size: 25rpx; font-weight: 600; line-height: 1.55; }
.clarify-supplement { width: 100%; min-height: 126rpx; margin-top: 18rpx; padding: 16rpx; box-sizing: border-box; border: 1rpx solid #dce8f7; border-radius: 14rpx; background: #ffffff; color: #182238; font-size: 24rpx; line-height: 1.55; }
.pending-option-selected { border-color: #2f63e6; background: #2f63e6; color: #ffffff; }
.pending-confirm { display: block; text-align: center; }
.pending-confirm-disabled { opacity: 0.55; }
.plan-project { margin-top: 16rpx; padding: 18rpx; border: 1rpx solid rgba(47, 99, 230, 0.16); border-radius: 16rpx; background: rgba(232, 240, 255, 0.62); }
.plan-task { margin-top: 18rpx; padding: 18rpx; border: 1rpx solid #e3ecf7; border-radius: 18rpx; background: rgba(255, 255, 255, 0.92); box-shadow: 0 10rpx 26rpx rgba(52, 92, 160, 0.05); }
.plan-task-head { display: flex; align-items: center; gap: 10rpx; }
.plan-task-number { display: flex; width: 36rpx; height: 36rpx; align-items: center; justify-content: center; border-radius: 10rpx; background: #2f63e6; color: #ffffff; font-size: 21rpx; line-height: 1; }
.plan-task-title { color: #182238; font-size: 25rpx; font-weight: 700; }
.plan-task-hint { margin-left: auto; color: #8296b0; font-size: 21rpx; }
.plan-field { margin-top: 14rpx; min-width: 0; }
.plan-label { display: block; margin-bottom: 8rpx; color: #4d6d94; font-size: 21rpx; font-weight: 600; }
.plan-input, .plan-textarea, .plan-picker-value { width: 100%; box-sizing: border-box; padding: 13rpx 15rpx; border: 1rpx solid #dce8f7; border-radius: 12rpx; background: #ffffff; color: #182238; font-size: 24rpx; line-height: 1.5; }
.plan-input { min-height: 70rpx; }
.plan-textarea { min-height: 104rpx; }
.plan-picker-value { min-height: 70rpx; }
.plan-grid { display: flex; gap: 12rpx; margin-top: 2rpx; }
.plan-grid .plan-field { flex: 1; min-width: 0; }
.plan-reason { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 18rpx; padding: 18rpx; border-radius: 14rpx; background: rgba(232, 240, 255, 0.66); color: #4d6d94; font-size: 23rpx; line-height: 1.65; }
.plan-reason-icon { flex-shrink: 0; color: #2f63e6; }
/* 今日任务行：对齐网页 AgendaTaskRow */
.task-tags { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 16rpx; }
.task-tag { display: inline-flex; height: 40rpx; align-items: center; gap: 6rpx; padding: 0 12rpx; border-radius: 8rpx; font-size: 22rpx; font-weight: 500; line-height: 1; }
.task-tag-icon { width: 24rpx; height: 24rpx; }
.task-tag-focus { background: #e8f0ff; color: #1e45b4; }
.task-tag-overdue { background: rgba(217, 80, 80, 0.1); color: #d95050; }
.task-tag-plan { background: #f1f5fa; color: #4d6d94; }
.task-meta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; margin-top: 16rpx; }
.task-project { max-width: 100%; overflow: hidden; color: #4d6d94; font-size: 24rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.priority-badge { display: inline-flex; height: 44rpx; align-items: center; padding: 0 12rpx; border-radius: 12rpx; font-size: 22rpx; font-weight: 500; line-height: 1; }
.priority-low { background: #edf4fb; color: #4d6d94; }
.priority-medium { background: #e8f0ff; color: #1e45b4; }
.priority-high { background: rgba(212, 134, 43, 0.1); color: #d4862b; }
.priority-urgent { background: rgba(217, 80, 80, 0.1); color: #d95050; }
.task-due { color: #d95050; font-size: 24rpx; line-height: 1.5; }
.task-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.task-chevron { flex-shrink: 0; width: 14rpx; height: 14rpx; margin-top: 10rpx; border-right: 3rpx solid #8296b0; border-bottom: 3rpx solid #8296b0; transform: rotate(45deg); transition: transform 160ms ease; }
.task-chevron-open { transform: rotate(225deg); }
.task-detail { margin-top: 16rpx; }
.task-detail-edit { display: inline-block; margin-top: 12rpx; color: #2f63e6; font-size: 22rpx; font-weight: 600; }

/* 对话式澄清：与网页端 ChatClarify 对齐 */
.chat-turn { display: flex; align-items: flex-start; gap: 12rpx; margin-bottom: 14rpx; }
.chat-turn-user { justify-content: flex-end; }
.chat-turn-ai { justify-content: flex-start; }
.chat-avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 44rpx; height: 44rpx; margin-top: 4rpx; border-radius: 10rpx; background: #e8f0ff; color: #2f63e6; font-size: 22rpx; }
.chat-bubble { max-width: 78%; padding: 16rpx 20rpx; border-radius: 18rpx; font-size: 26rpx; line-height: 1.6; white-space: pre-wrap; }
.chat-bubble-user { background: #f1f5f9; color: #182238; border-top-right-radius: 6rpx; }
.chat-bubble-ai { border: 1rpx solid #e3ecf7; border-radius: 18rpx 18rpx 18rpx 6rpx; background: #ffffff; color: #182238; }
.chat-options { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin: 6rpx 0 14rpx; }
.chat-option { padding: 14rpx 22rpx; border: 1rpx solid #e2e8f0; border-radius: 12rpx; background: #f1f5f9; color: #334155; font-size: 24rpx; line-height: 1.25; }
.chat-option-selected { border-color: #2f63e6; background: #e8f0ff; color: #1e45b4; }
.chat-direct-toggle { padding: 14rpx 22rpx; border: 1rpx solid #e2e8f0; border-radius: 12rpx; background: #f1f5f9; color: #334155; font-size: 24rpx; line-height: 1.25; }
.chat-direct-toggle-active { border-color: #2f63e6; background: #e8f0ff; color: #1e45b4; }
.chat-multi-actions { display: flex; align-items: center; justify-content: space-between; margin: -4rpx 0 14rpx; }
.chat-multi-hint { color: #7b8ba3; font-size: 21rpx; }
.chat-confirm { padding: 10rpx 22rpx; border-radius: 12rpx; background: #2f63e6; color: #ffffff; font-size: 23rpx; font-weight: 600; }
.chat-direct { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.chat-input { flex: 1; min-width: 0; padding: 14rpx 18rpx; border: 1rpx solid #dce8f7; border-radius: 14rpx; background: #ffffff; font-size: 24rpx; }
.chat-send { flex-shrink: 0; padding: 14rpx 24rpx; border-radius: 14rpx; background: #2f63e6; color: #ffffff; font-size: 24rpx; font-weight: 600; }
.chat-loading-bubble { display: flex; align-items: center; gap: 10rpx; color: #4d6d94; }
.inline-spinner { animation: inline-spin 1.1s linear infinite; color: #2f63e6; font-size: 28rpx; }
.pending-go { display: flex; align-items: center; justify-content: center; width: 150rpx; height: 64rpx; margin: 14rpx 0 0 auto; border-radius: 14rpx; background: #2f63e6; color: #ffffff; font-size: 23rpx; font-weight: 600; }
@keyframes inline-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

/* 今日建议的推荐理由：与网页端同源展示 */
.task-reason { color: #0faec8; font-size: 24rpx; line-height: 1.5; }

.tour-hint { position: fixed; right: 24rpx; bottom: calc(132rpx + env(safe-area-inset-bottom)); left: 24rpx; z-index: 35; padding: 32rpx; border: 1rpx solid rgba(255,255,255,.9); border-radius: 24rpx; background: rgba(255,255,255,.96); box-shadow: 0 24rpx 70rpx rgba(52,92,160,.18); }
.tour-hint-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.tour-hint-title { color: #182238; font-size: 28rpx; font-weight: 600; }
.tour-hint-close { color: #7e93ae; font-size: 34rpx; line-height: 1; }
.tour-hint-body { margin-top: 12rpx; color: #4d6d94; font-size: 24rpx; line-height: 1.7; }
.tour-hint-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; color: #7e93ae; font-size: 24rpx; }
.tour-hint-action { display: flex; height: 56rpx; align-items: center; padding: 0 20rpx; border: 1rpx solid rgba(255,255,255,.9); border-radius: 12rpx; background: #fff; color: #4d6d94; font-size: 24rpx; font-weight: 500; }

.task-action-spinner { display: inline-flex; align-items: center; justify-content: center; color: #2f63e6; font-size: 24rpx; line-height: 1; animation: inline-spin 1s linear infinite; }
