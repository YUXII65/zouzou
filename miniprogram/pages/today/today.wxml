<view class="page theme-{{theme}}">
  <view class="content">
    <view class="capture-card">
      <textarea
        class="capture-input"
        value="{{content}}"
        maxlength="500"
        placeholder="思考与困惑，计划与执行，直接倒出你的想法"
        placeholder-class="capture-placeholder"
        bindinput="onContentInput"
      ></textarea>
      <view class="capture-actions">
        <view class="next-button" bindtap="onSubmit">✦ 下一步</view>
      </view>
      <view class="sample-list">
        <view class="sample-chip" wx:for="{{samples}}" wx:key="title" data-sample="{{item.content}}" bindtap="onSampleTap">{{item.title}}</view>
      </view>
      <view class="sample-refresh-row">
        <view class="refresh-button" bindtap="onRefreshSamples">↻ 换一批</view>
      </view>
    </view>

    <view class="pending-list" wx:if="{{pendingItems.length > 0}}">
      <view class="pending-card" wx:for="{{pendingItems}}" wx:key="id" wx:for-item="pending" wx:for-index="itemIndex">
        <view
          class="chat-turn chat-turn-{{turn.role}}"
          wx:for="{{pending.turns}}"
          wx:key="index"
          wx:for-item="turn"
          wx:for-index="turnIndex"
        >
          <view class="chat-bubble chat-bubble-{{turn.role}}">{{turn.text}}</view>
        </view>

        <view class="chat-options" wx:if="{{pending.options.length > 0}}">
          <view
            class="chat-option {{option.selected ? 'chat-option-selected' : ''}}"
            wx:for="{{pending.options}}"
            wx:key="label"
            wx:for-item="option"
            wx:for-index="optionIndex"
            data-item-index="{{itemIndex}}"
            data-option-index="{{optionIndex}}"
            bindtap="onClarifyOptionTap"
          >{{option.label}}</view>
        </view>

        <view class="chat-tools" wx:if="{{pending.options.length > 0}}">
          <view class="chat-direct-toggle" data-item-index="{{itemIndex}}" bindtap="onClarifyDirectToggle">想自己说</view>
          <view class="chat-confirm" wx:if="{{pending.multi}}" data-item-index="{{itemIndex}}" bindtap="onClarifyMultiConfirm">确定</view>
        </view>

        <view class="chat-direct" wx:if="{{pending.directInput}}">
          <input class="chat-input" value="{{pending.typed}}" placeholder="输入你想说的话" data-item-index="{{itemIndex}}" bindinput="onClarifyTypedInput" />
          <view class="chat-send" data-item-index="{{itemIndex}}" bindtap="onClarifyDirectSend">发送</view>
        </view>

        <view
          class="pending-confirm {{submittingClarifyId ? 'pending-confirm-disabled' : ''}}"
          wx:if="{{pending.clarifyStatus === 'done' && !pending.planReady && !pending.isAnswer}}"
          data-item-index="{{itemIndex}}"
          bindtap="onGeneratePlan"
        >
          {{submittingClarifyId === pending.id ? '正在整理...' : '信息够了，给我下一步'}}
        </view>

        <view class="pending-plan" wx:if="{{pending.isAnswer}}">
          <view class="plan-reason" wx:if="{{pending.directAnswer}}">
            <text class="plan-reason-icon">✦</text>
            <text>{{pending.directAnswer}}</text>
          </view>
          <view class="pending-confirm {{submittingPlanId ? 'pending-confirm-disabled' : ''}}" data-item-index="{{itemIndex}}" bindtap="onConfirmPlan">
            {{submittingPlanId === pending.id ? '正在收下...' : '收下回答'}}
          </view>
        </view>

        <view class="pending-plan" wx:if="{{pending.planReady}}">
          <view class="plan-reason" wx:if="{{pending.reason}}">
            <text class="plan-reason-icon">✦</text>
            <text>{{pending.reason}}</text>
          </view>
          <view class="pending-confirm {{submittingPlanId ? 'pending-confirm-disabled' : ''}}" data-item-index="{{itemIndex}}" bindtap="onConfirmPlan">
            {{submittingPlanId === pending.id ? '正在整理...' : '放入文件页'}}
          </view>
        </view>

        <view class="pending-footer">
          <view class="pending-ignore {{ignoringInboxId === pending.id ? 'pending-confirm-disabled' : ''}}" data-id="{{pending.id}}" bindtap="onIgnoreInbox">忽略</view>
        </view>
      </view>
    </view>

    <view class="panel tasks-panel">
      <view class="panel-header">
        <text class="panel-title">今日建议</text>
        <text class="panel-count">{{tasks.length}} 条</text>
      </view>
      <view class="empty-state" wx:if="{{tasks.length === 0}}">
        <view class="empty-icon">◎</view>
        <view class="empty-title">今天还没有重点</view>
        <view class="empty-hint">先记录一个想法，会先听懂你，再陪你真正做起来。</view>
        <view class="empty-action" bindtap="onSubmit">记一个想法 →</view>
      </view>
      <view class="task-list" wx:else>
        <view class="task-row" wx:for="{{tasks}}" wx:key="id">
          <view class="task-copy">
            <view class="task-tags">
              <text class="task-tag task-tag-focus" wx:if="{{item.isFocused}}">重点</text>
              <text class="task-tag task-tag-overdue" wx:if="{{item.isOverdue}}">逾期</text>
              <text class="task-tag task-tag-plan" wx:if="{{item.isScheduled}}">计划</text>
            </view>
            <view class="task-title" data-id="{{item.id}}" bindtap="onTaskExpandTap">{{item.displayTitle}}</view>
            <view class="task-meta-row">
              <text class="task-priority">{{item.priorityLabel}}</text>
              <text class="task-meta">{{item.projectName}}</text>
              <text class="task-reason" wx:if="{{item.reason}}">{{item.reason}}</text>
            </view>
            <text class="task-due" wx:if="{{item.dueDateText}}">截止 {{item.dueDateText}}</text>
            <view class="task-detail" wx:if="{{expandedTaskId === item.id}}">
              <view class="task-sticky" wx:if="{{item.sticky}}">
                <view class="task-sticky-title">{{item.sticky.title}}</view>
                <view class="task-sticky-copy" wx:if="{{item.sticky.encouragement}}">{{item.sticky.encouragement}}</view>
                <view class="task-sticky-step" wx:for="{{item.sticky.steps}}" wx:key="*this" wx:for-item="step">{{index + 1}}. {{step}}</view>
                <view class="task-sticky-next" wx:if="{{item.sticky.nextStep}}">现在可以做：{{item.sticky.nextStep}}</view>
              </view>
              <view class="task-detail-title">{{item.title}}</view>
              <view class="task-detail-copy" wx:if="{{item.notes && item.notes !== item.title}}">{{item.notes}}</view>
              <view class="task-detail-standard" wx:if="{{item.doneWhen}}">完成标准：{{item.doneWhen}}</view>
            </view>
          </view>
          <view class="task-action {{item.canChangeStatus ? '' : 'task-action-disabled'}}" data-id="{{item.id}}" data-status="{{item.nextStatus}}" bindtap="onTaskStatusTap">{{item.actionLabel}}</view>
        </view>
      </view>
    </view>

  </view>

  <bottom-nav active="today" theme="{{theme}}"></bottom-nav>
</view>
