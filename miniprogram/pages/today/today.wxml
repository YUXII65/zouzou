<view class="page">
  <view class="topbar">
    <view class="brand-row">
      <view class="brand-mark"><view class="brand-arrow"></view></view>
      <text class="brand-name">走走</text>
    </view>
    <view class="top-actions">
      <view class="top-icon" bindtap="onToolsTap">▦</view>
      <view class="avatar" bindtap="onProfileTap"><image wx:if="{{userAvatar}}" src="{{userAvatar}}" mode="aspectFill"></image><text wx:else>{{userInitial}}</text></view>
    </view>
  </view>

  <view class="content">
    <view class="panel date-panel">
      <view class="date-row">
        <view class="date-main">
          <text class="date-number">{{dateText}}</text>
          <text class="date-text">{{weekdayText}}</text>
        </view>
        <text class="clock">{{timeText}}</text>
        <view class="date-progress">
          <view class="progress-copy">
            <text>今日</text>
            <text>{{completedToday}} / {{totalToday}}，全部完成</text>
          </view>
          <view class="progress-track"><view class="progress-fill"></view></view>
        </view>
      </view>
      <view class="streak-pill">连续 {{streak}} 天 · 近 7 天 {{weekDone}} 件</view>
    </view>

    <view class="capture-card">
      <textarea
        class="capture-input"
        value="{{content}}"
        maxlength="500"
        placeholder="今天脑子里在转什么？直接倒出来"
        placeholder-class="capture-placeholder"
        bindinput="onContentInput"
      ></textarea>
      <view class="sample-list">
        <view class="sample-chip" wx:for="{{samples}}" wx:key="*this" data-sample="{{item}}" bindtap="onSampleTap">{{item}}</view>
      </view>
      <view class="capture-actions">
        <view class="refresh-button" bindtap="onRefreshSamples">↻ 换一批</view>
        <view class="next-button" bindtap="onSubmit">✦ 下一步</view>
      </view>
    </view>

    <view class="pending-list" wx:if="{{pendingItems.length > 0}}">
      <view class="pending-card" wx:for="{{pendingItems}}" wx:key="id" wx:for-item="pending" wx:for-index="itemIndex">
        <view class="pending-head">
          <view class="pending-content">{{pending.content}}</view>
          <view class="pending-action">{{pending.action}}</view>
        </view>

        <view class="pending-clarify" wx:if="{{pending.dimensions.length > 0}}">
          <view class="clarify-dimension" wx:for="{{pending.dimensions}}" wx:key="key" wx:for-item="dimension" wx:for-index="dimensionIndex">
            <view class="clarify-question">{{dimension.question}}</view>
            <view class="pending-options">
              <view
                class="pending-option {{option.selected ? 'pending-option-selected' : ''}}"
                wx:for="{{dimension.options}}"
                wx:key="label"
                wx:for-item="option"
                wx:for-index="optionIndex"
                data-item-index="{{itemIndex}}"
                data-dimension-index="{{dimensionIndex}}"
                data-option-index="{{optionIndex}}"
                bindtap="onClarifyOptionTap"
              >{{option.label}}</view>
            </view>
          </view>
          <textarea
            class="clarify-supplement"
            value="{{pending.supplement}}"
            maxlength="500"
            placeholder="{{pending.supplementPlaceholder}}"
            data-item-index="{{itemIndex}}"
            bindinput="onClarifySupplementInput"
          ></textarea>
          <view class="pending-confirm {{submittingClarifyId ? 'pending-confirm-disabled' : ''}}" data-item-index="{{itemIndex}}" bindtap="onClarifySubmit">
            {{submittingClarifyId === pending.id ? '正在整理...' : '确定方向，给我下一步'}}
          </view>
        </view>

        <view class="pending-plan" wx:if="{{pending.planTasks.length > 0}}">
          <view class="plan-project" wx:if="{{pending.showProjectFields}}">
            <view class="plan-field">
              <text class="plan-label">项目名称</text>
              <input class="plan-input" value="{{pending.projectName}}" placeholder="项目名称" data-item-index="{{itemIndex}}" data-field="projectName" bindinput="onPlanProjectInput" />
            </view>
            <view class="plan-field">
              <text class="plan-label">项目目标</text>
              <input class="plan-input" value="{{pending.projectObjective}}" placeholder="希望达到什么结果" data-item-index="{{itemIndex}}" data-field="projectObjective" bindinput="onPlanProjectInput" />
            </view>
          </view>

          <view class="plan-task" wx:for="{{pending.planTasks}}" wx:key="title" wx:for-item="task" wx:for-index="taskIndex">
            <view class="plan-task-head">
              <view class="plan-task-number">{{taskIndex + 1}}</view>
              <text class="plan-task-title">任务 {{taskIndex + 1}}</text>
              <text class="plan-task-hint">可执行步骤</text>
            </view>

            <view class="plan-field">
              <text class="plan-label">标题</text>
              <input class="plan-input" value="{{task.title}}" data-item-index="{{itemIndex}}" data-task-index="{{taskIndex}}" data-field="title" bindinput="onPlanTaskInput" />
            </view>
            <view class="plan-field">
              <text class="plan-label">内容</text>
              <textarea class="plan-textarea" value="{{task.notes}}" data-item-index="{{itemIndex}}" data-task-index="{{taskIndex}}" data-field="notes" bindinput="onPlanTaskInput"></textarea>
            </view>
            <view class="plan-field">
              <text class="plan-label">执行</text>
              <textarea class="plan-textarea" value="{{task.doneWhen}}" data-item-index="{{itemIndex}}" data-task-index="{{taskIndex}}" data-field="doneWhen" bindinput="onPlanTaskInput"></textarea>
            </view>

            <view class="plan-grid">
              <view class="plan-field">
                <text class="plan-label">优先级</text>
                <picker mode="selector" range="{{priorityLabels}}" value="{{task.priorityIndex}}" data-item-index="{{itemIndex}}" data-task-index="{{taskIndex}}" bindchange="onPlanPriorityChange">
                  <view class="plan-picker-value">{{task.priorityLabel}}</view>
                </picker>
              </view>
              <view class="plan-field">
                <text class="plan-label">截止日期</text>
                <picker mode="date" value="{{task.dueDate}}" data-item-index="{{itemIndex}}" data-task-index="{{taskIndex}}" data-field="dueDate" bindchange="onPlanDateChange">
                  <view class="plan-picker-value">{{task.dueDate ? task.dueDate : '选择日期'}}</view>
                </picker>
              </view>
            </view>
          </view>

          <view class="plan-reason" wx:if="{{pending.reason}}">
            <text class="plan-reason-icon">✦</text>
            <text>{{pending.reason}}</text>
          </view>
          <view class="pending-confirm {{submittingPlanId ? 'pending-confirm-disabled' : ''}}" data-item-index="{{itemIndex}}" bindtap="onConfirmPlan">
            {{submittingPlanId === pending.id ? '正在生成...' : '生成任务'}}
          </view>
        </view>

        <view class="pending-footer">
          <view class="pending-ignore {{ignoringInboxId === pending.id ? 'pending-confirm-disabled' : ''}}" data-id="{{pending.id}}" bindtap="onIgnoreInbox">忽略</view>
        </view>
      </view>
    </view>

    <view class="panel tasks-panel">
      <view class="panel-header">
        <text class="panel-title">今天要做</text>
        <text class="panel-count">{{tasks.length}} 条</text>
      </view>
      <view class="empty-state" wx:if="{{tasks.length === 0}}">
        <view class="empty-icon">◎</view>
        <view class="empty-title">今天还没有重点</view>
        <view class="empty-hint">先记录一个想法，会先听懂你，再帮你拆成今天能做的事。</view>
        <view class="empty-action" bindtap="onSubmit">记一个想法 →</view>
      </view>
      <view class="task-list" wx:else>
        <view class="task-row" wx:for="{{tasks}}" wx:key="id">
          <view class="task-copy">
            <view class="task-tags">
              <text class="task-tag task-tag-focus" wx:if="{{item.isFocused}}">重点</text>
              <text class="task-tag task-tag-overdue" wx:if="{{item.isOverdue}}">逾期</text>
              <text class="task-tag task-tag-plan" wx:if="{{item.isScheduled}}">计划</text>
            </view>
            <view class="task-title" data-id="{{item.id}}" bindtap="onTaskExpandTap">{{item.displayTitle}}</view>
            <view class="task-meta-row">
              <text class="task-priority">{{item.priorityLabel}}</text>
              <text class="task-meta">{{item.projectName}}</text>
            </view>
            <text class="task-due" wx:if="{{item.dueDateText}}">截止 {{item.dueDateText}}</text>
            <view class="task-detail" wx:if="{{expandedTaskId === item.id}}">
              <view class="task-detail-title">{{item.title}}</view>
              <view class="task-detail-copy" wx:if="{{item.notes && item.notes !== item.title}}">{{item.notes}}</view>
              <view class="task-detail-standard" wx:if="{{item.doneWhen}}">完成标准：{{item.doneWhen}}</view>
              <view class="task-detail-edit" data-id="{{item.id}}" catchtap="onTaskEditTap">编辑任务</view>
            </view>
          </view>
          <view class="task-action" data-id="{{item.id}}" data-status="{{item.nextStatus}}" bindtap="onTaskStatusTap">{{item.actionLabel}}</view>
        </view>
      </view>
    </view>

    <view class="review-link" bindtap="onTabTap" data-key="review">去复盘 →</view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item nav-item-active" data-key="today" bindtap="onTabTap">
      <text class="nav-icon">▦</text>
      <text>日历</text>
    </view>
    <view class="nav-item" data-key="desk" bindtap="onTabTap">
      <text class="nav-icon">▤</text>
      <text>书桌</text>
    </view>
    <view class="nav-item" data-key="review" bindtap="onTabTap">
      <text class="nav-icon">▣</text>
      <text>抽屉</text>
    </view>
  </view>
</view>
