<template name="agenda-task">
  <view class="task-row">
    <view class="task-copy">
      <view class="task-tags">
        <text class="task-tag task-tag-focus" wx:if="{{item.isFocused}}">重点</text>
        <text class="task-tag task-tag-overdue" wx:if="{{item.isOverdue}}">逾期</text>
        <text class="task-tag task-tag-plan" wx:if="{{item.isScheduled}}">计划</text>
      </view>
      <view class="task-title" data-id="{{item.id}}" bindtap="onTaskExpandTap">{{item.displayTitle}}</view>
      <view class="task-meta-row">
        <text class="task-priority">{{item.priorityLabel}}</text>
        <text class="task-meta">{{item.projectName}}</text>
        <text class="task-reason" wx:if="{{item.reason}}">{{item.reason}}</text>
      </view>
      <text class="task-due" wx:if="{{item.dueDateText}}">建议 {{item.dueDateText}}前完成</text>
      <view class="task-detail" wx:if="{{expandedTaskId === item.id}}">
        <task-sticky
          id="task-sticky-{{item.id}}"
          task-id="{{item.id}}"
          title="{{item.title}}"
          notes="{{item.notes}}"
          project-name="{{item.projectName}}"
          status="{{item.status}}"
          initial-notes="{{item.stickyNotes}}"
          data-id="{{item.id}}"
          bind:change="onStickyChange"
        ></task-sticky>
      </view>
    </view>
    <view class="task-action-row">
      <view class="task-action task-action-{{item.statusClass}} {{item.canChangeStatus ? '' : 'task-action-disabled'}}" data-id="{{item.id}}" data-status="{{item.nextStatus}}" bindtap="onTaskStatusTap">
        <text class="task-action-icon">{{item.statusIcon}}</text>
        <text>{{item.actionLabel}}</text>
      </view>
    </view>
  </view>
</template>

<view class="page theme-{{theme}}">
  <view class="content" style="padding-top: {{contentTop}}px;">
    <view class="planner-card">
      <view class="capture-card" wx:if="{{pendingItems.length === 0}}">
        <block wx:if="{{captureLoading}}">
          <view class="chat-turn chat-turn-user">
            <view class="chat-bubble chat-bubble-user">{{pendingCaptureContent}}</view>
          </view>
          <view class="chat-turn chat-turn-ai">
            <view class="chat-avatar">✦</view>
            <view class="chat-bubble chat-bubble-ai chat-loading-bubble"><text class="inline-spinner">◌</text><text>{{captureWaitingText}}</text></view>
          </view>
        </block>
        <block wx:else>
          <textarea
            class="capture-input"
            value="{{content}}"
            maxlength="500"
            placeholder="思考与困惑，计划与执行，直接倒出你的想法"
            placeholder-class="capture-placeholder"
            bindinput="onContentInput"
          ></textarea>
          <view class="capture-actions">
            <view class="next-button" bindtap="onSubmit">✦ 下一步</view>
          </view>
          <view class="sample-list">
            <view class="sample-chip" wx:for="{{samples}}" wx:key="title" data-sample="{{item.content}}" bindtap="onSampleTap">{{item.title}}</view>
          </view>
          <view class="sample-refresh-row">
            <view class="refresh-button" bindtap="onRefreshSamples">↻ 换一批</view>
          </view>
        </block>
      </view>

    <view class="pending-list" wx:if="{{pendingItems.length > 0}}">
      <view class="pending-card" wx:for="{{pendingItems}}" wx:key="id" wx:for-item="pending" wx:for-index="itemIndex">
        <view
          class="chat-turn chat-turn-{{turn.role}}"
          wx:for="{{pending.turns}}"
          wx:key="index"
          wx:for-item="turn"
          wx:for-index="turnIndex"
        >
          <view class="chat-avatar" wx:if="{{turn.role === 'ai'}}">✦</view>
          <view class="chat-bubble chat-bubble-{{turn.role}}">{{turn.text}}</view>
        </view>

        <view class="chat-options" wx:if="{{pending.options.length > 0 && !pending.isThinking && !pending.completed}}">
          <view
            class="chat-option {{option.selected ? 'chat-option-selected' : ''}}"
            wx:for="{{pending.options}}"
            wx:key="label"
            wx:for-item="option"
            wx:for-index="optionIndex"
            data-item-index="{{itemIndex}}"
            data-option-index="{{optionIndex}}"
            bindtap="onClarifyOptionTap"
          >{{option.label}}</view>
          <view class="chat-direct-toggle {{pending.directInput ? 'chat-direct-toggle-active' : ''}}" data-item-index="{{itemIndex}}" bindtap="onClarifyDirectToggle">↩ 想自己说</view>
        </view>

        <view class="chat-multi-actions" wx:if="{{pending.multi && !pending.isThinking && !pending.completed}}">
          <text class="chat-multi-hint">可多选</text>
          <view class="chat-confirm" data-item-index="{{itemIndex}}" bindtap="onClarifyMultiConfirm">确定</view>
        </view>

        <view class="chat-direct" wx:if="{{pending.directInput && !pending.isThinking && !pending.completed}}">
          <input class="chat-input" value="{{pending.typed}}" placeholder="输入你想说的话" data-item-index="{{itemIndex}}" bindinput="onClarifyTypedInput" />
          <view class="chat-send" data-item-index="{{itemIndex}}" bindtap="onClarifyDirectSend">发送</view>
        </view>

        <view
          class="pending-confirm {{submittingClarifyId ? 'pending-confirm-disabled' : ''}}"
          wx:if="{{pending.clarifyStatus === 'done' && !pending.planReady && !pending.isAnswer && !pending.isThinking && !pending.completed}}"
          data-item-index="{{itemIndex}}"
          bindtap="onGeneratePlan"
        >
          信息够了，给我下一步
        </view>

        <view class="pending-plan" wx:if="{{pending.isAnswer && !pending.isThinking && !pending.completed}}">
          <view class="plan-reason" wx:if="{{pending.directAnswer}}">
            <text class="plan-reason-icon">✦</text>
            <text>{{pending.directAnswer}}</text>
          </view>
          <view class="pending-confirm {{submittingPlanId ? 'pending-confirm-disabled' : ''}}" data-item-index="{{itemIndex}}" bindtap="onConfirmPlan">
            {{submittingPlanId === pending.id ? '正在收好…' : '收下回答'}}
          </view>
        </view>

        <view class="pending-plan" wx:if="{{pending.planReady && !pending.isThinking && !pending.completed}}">
          <view class="pending-confirm {{submittingPlanId ? 'pending-confirm-disabled' : ''}}" data-item-index="{{itemIndex}}" bindtap="onConfirmPlan">
            收好并继续
          </view>
        </view>

        <view class="chat-turn chat-turn-ai" wx:if="{{pending.isThinking}}">
          <view class="chat-avatar">✦</view>
          <view class="chat-bubble chat-bubble-ai chat-loading-bubble"><text class="inline-spinner">◌</text><text>{{pending.thinkingText}}</text></view>
        </view>

        <view class="chat-turn chat-turn-ai" wx:if="{{pending.completed}}">
          <view class="chat-avatar">✦</view>
          <view class="chat-bubble chat-bubble-ai">{{pending.completionText}}</view>
        </view>
        <view class="pending-go" wx:if="{{pending.completed}}" bindtap="onGoFiles">去看看</view>

      </view>
    </view>
    </view>

    <view class="panel tasks-panel">
      <view class="panel-header">
        <text class="panel-title">今日建议</text>
        <text class="panel-count">{{plannedTasks.length}} 条</text>
      </view>
      <view class="empty-state" wx:if="{{plannedTasks.length === 0 && completedTodayTasks.length === 0}}">
        <view class="empty-icon">◎</view>
        <view class="empty-title">今天还没有重点</view>
      </view>
      <view class="task-list" wx:else>
        <template is="agenda-task" wx:for="{{plannedTasks}}" wx:key="id" data="{{item: item, expandedTaskId: expandedTaskId}}"></template>
        <view class="completed-divider" wx:if="{{completedTodayTasks.length}}">
          <text class="completed-check">✓</text>
          <text>今天完成 {{completedTodayTasks.length}}</text>
        </view>
        <template is="agenda-task" wx:for="{{completedTodayTasks}}" wx:key="id" data="{{item: item, expandedTaskId: expandedTaskId}}"></template>
      </view>
    </view>
  </view>
</view>
