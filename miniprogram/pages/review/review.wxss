.page {
  min-height: 100vh;
  padding-bottom: 130rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #e9f3ff 0%, #f6faff 50%, #eaf8fa 100%);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.72);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.85);
}

.brand-row,
.top-actions { display: flex; align-items: center; }
.brand-row { gap: 14rpx; }
.top-actions { gap: 16rpx; }

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: #2f63e6;
}

.brand-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 6rpx solid #ffffff;
  border-right: 6rpx solid #ffffff;
  transform: rotate(45deg) translate(-3rpx, 3rpx);
}

.brand-name { color: #182238; font-size: 28rpx; font-weight: 600; }

.top-icon,
.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #4d6d94;
  font-size: 28rpx;
}

.avatar { background: #e8f0ff; color: #1e45b4; font-weight: 700; }

.content { padding: 30rpx 24rpx 40rpx; }

.page-heading {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 28rpx;
}

.eyebrow { color: #2f63e6; font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; }
.page-title { color: #182238; font-size: 48rpx; font-weight: 700; }
.page-subtitle { color: #4d6d94; font-size: 24rpx; }

.panel {
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 18rpx 50rpx rgba(52, 92, 160, 0.1);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid rgba(220, 232, 247, 0.8);
}

.panel-title { color: #182238; font-size: 30rpx; font-weight: 700; }
.panel-count { color: #8296b0; font-size: 23rpx; }

.today-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 26rpx;
  color: #182238;
  font-size: 26rpx;
  background: #e8f0ff;
}

.muted { color: #8296b0; font-size: 23rpx; }
.history-empty { padding: 34rpx; color: #8296b0; font-size: 24rpx; text-align: center; }

.review-form { padding: 26rpx; }

.date-field {
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #edf4fb;
  color: #182238;
  font-size: 27rpx;
  line-height: 84rpx;
}

.generate-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: #2f63e6;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
}

.week-stats {
  display: flex;
  gap: 14rpx;
  padding: 24rpx;
}

.week-stat {
  flex: 1;
  padding: 22rpx 18rpx;
  border-radius: 16rpx;
}

.week-stat.success { background: rgba(28, 157, 106, 0.08); }
.week-stat.warning { background: rgba(212, 134, 43, 0.08); }
.week-stat.neutral { background: #edf4fb; }
.success { color: #1c9d6a; }
.warning { color: #d4862b; }
.neutral { color: #4d6d94; }

.week-stat > text:first-child { font-size: 22rpx; }
.week-number { display: block; margin-top: 8rpx; color: #182238; font-size: 44rpx; font-weight: 700; }

.bottom-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.9);
  border-top: 1rpx solid rgba(220, 232, 247, 0.9);
}

.nav-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #8296b0;
  font-size: 22rpx;
}

.nav-item-active { color: #2f63e6; font-weight: 600; }
.nav-icon { font-size: 32rpx; line-height: 1; }.field-label { display: block; margin-bottom: 10rpx; color: #4d6d94; font-size: 22rpx; }
.review-textarea { width: 100%; min-height: 240rpx; margin-bottom: 22rpx; padding: 20rpx; box-sizing: border-box; border-radius: 16rpx; background: #edf4fb; color: #182238; font-size: 25rpx; line-height: 1.65; }
.review-textarea.small { min-height: 160rpx; }
.save-button { display: flex; align-items: center; justify-content: center; height: 84rpx; border-radius: 16rpx; background: #2f63e6; color: #ffffff; font-size: 26rpx; font-weight: 600; }
.task-row { display: flex; align-items: center; gap: 12rpx; padding: 20rpx 26rpx; border-bottom: 1rpx solid #eef3f9; }
.task-state { color: #d4862b; font-size: 28rpx; }
.task-state-done { color: #1c9d6a; }
.task-title { flex: 1; min-width: 0; color: #182238; font-size: 25rpx; }
.task-project { color: #8296b0; font-size: 21rpx; }

/* 历史复盘、草稿反馈：对齐网页 ReviewPage / ReviewDraftFeedback */
.history-list { padding: 10rpx; }
.history-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 18rpx 20rpx; border-radius: 14rpx; color: #4d6d94; font-size: 24rpx; }
.history-item-active { background: #e8f0ff; color: #1e45b4; font-weight: 600; }
.review-feedback { display: flex; gap: 12rpx; padding: 16rpx 26rpx 0; }
.feedback-button { padding: 10rpx 18rpx; border: 1rpx solid #dce8f7; border-radius: 999rpx; background: #ffffff; color: #8296b0; font-size: 22rpx; }
.feedback-useful { border-color: rgba(28, 157, 106, 0.25); background: rgba(28, 157, 106, 0.1); color: #1c9d6a; }
.feedback-useless { border-color: rgba(217, 80, 80, 0.22); background: rgba(217, 80, 80, 0.1); color: #d95050; }
.save-button-saved { background: rgba(28, 157, 106, 0.12); color: #1c9d6a; }