<view class="page">
  <view class="topbar">
    <view class="brand-row">
      <view class="brand-mark"><view class="brand-arrow"></view></view>
      <text class="brand-name">走走</text>
    </view>
    <view class="top-actions">
      <view class="top-icon" bindtap="onToolsTap">▦</view>
      <view class="avatar" bindtap="onProfileTap"><image wx:if="{{userAvatar}}" src="{{userAvatar}}" mode="aspectFill"></image><text wx:else>{{userInitial}}</text></view>
    </view>
  </view>

  <view class="content">
    <view class="page-heading">
      <text class="eyebrow">让想法，走成下一步</text>
      <text class="page-title">抽屉</text>
      <text class="page-subtitle">每日复盘，并给出明天的执行建议</text>
    </view>

    <view class="panel history-panel">
      <view class="panel-header">
        <text class="panel-title">历史复盘</text>
        <text class="panel-count">{{reviews.length}} 份</text>
      </view>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="today-row">
          <text>选择日期</text>
          <text class="muted">{{date}} · {{reviewStatus === 'final' ? '已保存' : (reviewId ? '草稿' : '未写')}}</text>
        </view>
      </picker>
      <view class="history-list" wx:if="{{reviews.length}}">
        <view class="history-item {{item.date === date ? 'history-item-active' : ''}}" wx:for="{{reviews}}" wx:key="id" data-date="{{item.date}}" bindtap="onHistoryTap">
          <text>{{item.date}}</text>
          <text class="muted">{{item.completedCount}} / {{item.openCount}}</text>
        </view>
      </view>
      <view class="history-empty" wx:else>还没有历史复盘</view>
    </view>
    <view class="panel review-panel">
      <view class="panel-header">
        <text class="panel-title">{{reviewId ? '当日复盘' : '写今日复盘'}}</text>
      </view>
      <view class="review-feedback" wx:if="{{reviewId}}">
        <view class="feedback-button {{feedback === 'useful' ? 'feedback-useful' : ''}}" data-action="useful" bindtap="onFeedbackTap">有帮助</view>
        <view class="feedback-button {{feedback === 'useless' ? 'feedback-useless' : ''}}" data-action="useless" bindtap="onFeedbackTap">没帮助</view>
      </view>
      <view class="review-form" wx:if="{{!reviewId}}">
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
          <view class="date-field">{{date}}</view>
        </picker>
        <view class="generate-button" bindtap="onGenerate">▦ 生成复盘</view>
      </view>
      <view class="review-form" wx:else>
        <text class="field-label">当日总结</text>
        <textarea class="review-textarea" value="{{summary}}" placeholder="写下今天真正推进了什么，卡在哪里" bindinput="onSummaryInput"></textarea>
        <text class="field-label">下一步任务（1-3 条）</text>
        <textarea class="review-textarea small" value="{{nextActions}}" placeholder="每条两行：精简标题 + 具体说明" bindinput="onNextActionsInput"></textarea>
        <view class="save-button {{reviewSavedAlready ? 'save-button-saved' : ''}}" bindtap="onSave">{{reviewSavedAlready ? '保存成功' : '保存复盘'}}</view>
      </view>
    </view>

    <view class="panel task-panel" wx:if="{{reviewId}}">
      <view class="panel-header">
        <text class="panel-title">当日任务</text>
        <text class="panel-count">{{tasks.length}} 条</text>
      </view>
      <view class="task-list" wx:if="{{tasks.length}}">
        <view class="task-row" wx:for="{{tasks}}" wx:key="id">
          <text class="task-state {{item.status === 'done' ? 'task-state-done' : ''}}">{{item.status === 'done' ? '✓' : '○'}}</text>
          <text class="task-title">{{item.title}}</text>
          <text class="task-project" wx:if="{{item.projectName}}">{{item.projectName}}</text>
        </view>
      </view>
      <view class="history-empty" wx:else>当天没有任务记录</view>
    </view>

    <view class="panel week-panel">
      <view class="panel-header">
        <text class="panel-title">本周回看</text>
        <text class="panel-count">{{weekReviewCount}} 份每日复盘</text>
      </view>
      <view class="week-stats">
        <view class="week-stat success"><text>本周完成</text><text class="week-number">{{weekCompleted}}</text></view>
        <view class="week-stat warning"><text>待推进</text><text class="week-number">{{weekOpen}}</text></view>
        <view class="week-stat neutral"><text>涉及项目</text><text class="week-number">{{weekProjects}}</text></view>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item" data-key="today" bindtap="onTabTap"><text class="nav-icon">▦</text><text>日历</text></view>
    <view class="nav-item" data-key="desk" bindtap="onTabTap"><text class="nav-icon">▤</text><text>书桌</text></view>
    <view class="nav-item nav-item-active" data-key="review" bindtap="onTabTap"><text class="nav-icon">▣</text><text>抽屉</text></view>
  </view>
</view>