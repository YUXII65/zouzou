<template name="file-task">
  <view class="file-task">
    <view class="file-task-main">
      <view class="task-tags">
        <text class="task-tag task-tag-focus" wx:if="{{task.isFocused}}">重点</text>
        <text class="task-tag task-tag-overdue" wx:if="{{task.isOverdue}}">逾期</text>
        <text class="task-tag task-tag-plan" wx:if="{{task.isScheduled}}">计划</text>
      </view>
      <view class="file-task-title" data-id="{{task.id}}" bindtap="onTaskExpandTap">{{task.displayTitle}}</view>
      <view class="file-task-meta">
        <text class="task-priority">{{task.priorityLabel}}</text>
        <text wx:if="{{task.dueDateText}}">建议 {{task.dueDateText}}前完成</text>
      </view>
      <view class="task-detail" wx:if="{{expandedTaskId === task.id}}">
        <view class="task-detail-title">{{task.title}}</view>
        <view class="task-detail-copy" wx:if="{{task.notes && task.notes !== task.title}}">{{task.notes}}</view>
        <view class="task-detail-standard" wx:if="{{task.doneWhen}}">完成标准：{{task.doneWhen}}</view>
        <view class="task-detail-standard" wx:if="{{task.methodHint}}">做法：{{task.methodHint}}</view>
      </view>
    </view>
    <view class="file-task-actions">
      <view
        class="task-action {{submittingTaskId === task.id || !task.canChangeStatus ? 'task-action-disabled' : ''}}"
        data-id="{{task.id}}"
        data-status="{{task.nextStatus}}"
        catchtap="onTaskStatusTap"
      >{{submittingTaskId === task.id ? '同步中' : task.actionLabel}}</view>
    </view>
  </view>
</template>

<template name="folder">
  <view class="folder-card {{openId === project.id ? 'folder-card-open' : ''}} folder-card-{{project.modeKey}}">
    <view class="folder-tab folder-tab-{{project.modeKey}}"></view>
    <view class="folder-head" data-id="{{project.id}}" bindtap="onFolderTap">
      <view class="folder-icon folder-icon-{{project.modeKey}}">{{openId === project.id ? '▣' : '▤'}}</view>
      <view class="folder-copy">
        <text class="folder-name">{{project.name}}</text>
        <text class="folder-meta">{{project.modeLabel ? project.modeLabel + ' · ' : ''}}{{project.openCount ? project.openCount + ' 件推进中' : '暂无推进中的任务'}}</text>
      </view>
      <text class="folder-chevron">{{openId === project.id ? '⌃' : '⌄'}}</text>
    </view>

    <view class="folder-body" wx:if="{{openId === project.id}}">
      <view class="stage-card stage-card-{{project.stage.status}}" wx:if="{{project.modeKey === 'longterm' && project.stage}}">
        <text class="stage-label">第 {{project.stage.order}}/5 阶段</text>
        <text class="stage-copy">{{project.stage.summary}}</text>
        <view class="stage-next">
          <text class="stage-label">下一阶段 · 第 {{project.stage.nextOrder}}/5 阶段 · 预览</text>
          <text class="stage-copy">{{project.stage.nextSummary}}</text>
        </view>
      </view>

      <view class="track-list" wx:if="{{project.modeKey === 'explore' && project.tracks.length}}">
        <view class="track-row track-row-{{track.role}}" wx:for="{{project.tracks}}" wx:key="id" wx:for-item="track">
          <text class="track-role">{{track.role === 'main' ? '主线' : '支线'}}</text>
          <text class="track-name">{{track.name}}</text>
        </view>
      </view>

      <view class="task-switch">
        <view
          class="task-switch-item {{taskView === 'open' ? 'task-switch-item-active' : ''}}"
          data-view="open"
          bindtap="onTaskViewTap"
        >推进中 {{project.openCount}}</view>
        <view
          class="task-switch-item {{taskView === 'done' ? 'task-switch-item-done' : ''}}"
          data-view="done"
          bindtap="onTaskViewTap"
        >已完成 {{project.doneCount}}</view>
      </view>

      <view class="file-task-list" wx:if="{{taskView === 'open' && project.openTasks.length}}">
        <template is="file-task" wx:for="{{project.openTasks}}" wx:key="id" data="{{task: item, expandedTaskId: expandedTaskId, submittingTaskId: submittingTaskId}}"></template>
      </view>
      <view class="file-task-list" wx:if="{{taskView === 'done' && project.doneTasks.length}}">
        <template is="file-task" wx:for="{{project.doneTasks}}" wx:key="id" data="{{task: item, expandedTaskId: expandedTaskId, submittingTaskId: submittingTaskId}}"></template>
      </view>

      <view class="empty-state compact" wx:if="{{taskView === 'open' && !project.openTasks.length}}">
        <view class="empty-title">{{project.allDone ? '已全部完成' : '没有推进中的任务'}}</view>
        <view class="empty-hint" wx:if="{{!project.allDone}}">写下想法时 AI 会把它拆成这里的任务。</view>
      </view>
      <view class="empty-state compact" wx:if="{{taskView === 'done' && !project.doneTasks.length}}">
        <view class="empty-title">还没有已完成的任务</view>
        <view class="empty-hint">任务完成后会自动收进这里。</view>
      </view>
    </view>
  </view>
</template>

<view class="page theme-{{theme}}">
  <view class="content">
    <view class="list-toolbar" wx:if="{{projectsByTime.length}}">
      <view class="sort-toggle" bindtap="onToggleListMode">
        <text class="sort-icon">⇅</text>
        <text>{{listMode === 'type' ? '类型排序' : '时间排序'}}</text>
      </view>
    </view>

    <view wx:if="{{hasAnything}}">
      <block wx:if="{{listMode === 'type'}}">
        <view class="mode-group" wx:for="{{groups}}" wx:key="mode" wx:for-item="group">
          <view class="mode-head">
            <view class="mode-dot mode-dot-{{group.mode}}"></view>
            <text class="mode-label">{{group.label}}</text>
            <text class="mode-count">{{group.projects.length}}</text>
          </view>
          <template is="folder" wx:for="{{group.projects}}" wx:key="id" wx:for-item="project" data="{{project: project, openId: openId, taskView: taskView, expandedTaskId: expandedTaskId, submittingTaskId: submittingTaskId}}"></template>
        </view>
      </block>

      <block wx:else>
        <template is="folder" wx:for="{{projectsByTime}}" wx:key="id" wx:for-item="project" data="{{project: project, openId: openId, taskView: taskView, expandedTaskId: expandedTaskId, submittingTaskId: submittingTaskId}}"></template>
      </block>

      <template wx:if="{{unassociated}}" is="folder" data="{{project: unassociated, openId: openId, taskView: taskView, expandedTaskId: expandedTaskId, submittingTaskId: submittingTaskId}}"></template>
    </view>

    <view class="empty-state empty-page" wx:else>
      <view class="empty-icon">▤</view>
      <view class="empty-title">还没有文件夹</view>
      <view class="empty-hint">写下第一个想法，AI 会把它收成一个文件夹。</view>
    </view>
  </view>

  <bottom-nav active="desk" theme="{{theme}}"></bottom-nav>
</view>
