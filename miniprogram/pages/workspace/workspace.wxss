.page {
  min-height: 100vh;
  padding-bottom: 130rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #e9f3ff 0%, #f6faff 50%, #eaf8fa 100%);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.72);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.85);
}

.brand-row,
.top-actions {
  display: flex;
  align-items: center;
}

.brand-row {
  gap: 14rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: #2f63e6;
}

.brand-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 6rpx solid #ffffff;
  border-right: 6rpx solid #ffffff;
  transform: rotate(45deg) translate(-3rpx, 3rpx);
}

.brand-name {
  color: #182238;
  font-size: 28rpx;
  font-weight: 600;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #e8f0ff;
  color: #1e45b4;
  font-size: 28rpx;
  font-weight: 700;
}

.content {
  padding-top: calc(env(safe-area-inset-top) + 160rpx);
  padding-right: 24rpx;
  padding-bottom: 40rpx;
  padding-left: 24rpx;
}

.list-toolbar {
  display: flex;
  justify-content: flex-end;
  margin-top: 80rpx;
  padding: 0 4rpx 16rpx;
}

.sort-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 160rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #dce8f7;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #4d6d94;
  font-size: 22rpx;
  font-weight: 600;
}

.sort-icon {
  font-size: 24rpx;
  line-height: 1;
}

.page.theme-dark .sort-toggle {
  border-color: #2d3a49;
  background: #202b38;
  color: #b4c1d0;
}

.mode-group + .mode-group {
  margin-top: 26rpx;
}

.mode-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 8rpx 10rpx;
}

.mode-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.mode-dot-normal { background: #4a9ae8; }
.mode-dot-longterm { background: #1e3f9c; }
.mode-dot-explore { background: #7b4fd6; }

.mode-label {
  color: #7e93ae;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.mode-count {
  color: #8296b0;
  font-size: 21rpx;
}

.folder-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(220, 232, 247, 0.86);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 12rpx 34rpx rgba(52, 92, 160, 0.07);
}

.folder-card + .folder-card {
  margin-top: 16rpx;
}

.folder-card-open {
  border-color: #c9dcf5;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 18rpx 44rpx rgba(52, 92, 160, 0.12);
}

.folder-tab {
  position: absolute;
  left: 28rpx;
  top: 0;
  width: 76rpx;
  height: 12rpx;
  border-radius: 0 0 10rpx 10rpx;
  opacity: 0.74;
}

.folder-tab-normal { background: #4a9ae8; }
.folder-tab-longterm { background: #1e3f9c; }
.folder-tab-explore { background: #7b4fd6; }
.folder-tab-unassigned { background: #9fb1c8; }

.folder-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 24rpx 22rpx;
}

.folder-card-open .folder-head {
  padding-bottom: 20rpx;
}

.folder-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1;
}

.folder-icon-normal { background: #e3f1fd; color: #1667b8; }
.folder-icon-longterm { background: #dce6f9; color: #1a3480; }
.folder-icon-explore { background: #ece4fc; color: #5f31b8; }
.folder-icon-unassigned { background: #eef3f9; color: #7e93ae; }

.folder-copy {
  flex: 1;
  min-width: 0;
}

.folder-name {
  display: block;
  overflow: hidden;
  color: #182238;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.folder-meta {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: #8296b0;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.folder-chevron {
  flex-shrink: 0;
  color: #8296b0;
  font-size: 30rpx;
  line-height: 1;
}

.folder-body {
  padding: 0 22rpx 22rpx;
  border-top: 1rpx solid #eef3f9;
}

.stage-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(47, 99, 230, 0.2);
  border-radius: 16rpx;
  background: rgba(232, 240, 255, 0.62);
}

.stage-card-ready {
  border-color: rgba(28, 157, 106, 0.26);
  background: rgba(28, 157, 106, 0.06);
}

.stage-label {
  display: block;
  color: #1e45b4;
  font-size: 21rpx;
  font-weight: 700;
}

.stage-copy {
  display: block;
  margin-top: 8rpx;
  color: #182238;
  font-size: 23rpx;
  line-height: 1.65;
}

.stage-next {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(47, 99, 230, 0.14);
}

.track-list {
  margin-top: 18rpx;
}

.track-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(220, 232, 247, 0.8);
  border-radius: 14rpx;
  background: #f7faff;
}

.track-row + .track-row {
  margin-top: 10rpx;
}

.track-row-main {
  border-color: rgba(123, 79, 214, 0.28);
  background: rgba(236, 228, 252, 0.6);
}

.track-role {
  flex-shrink: 0;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: #eef3f9;
  color: #7e93ae;
  font-size: 19rpx;
}

.track-row-main .track-role {
  background: rgba(123, 79, 214, 0.14);
  color: #5f31b8;
}

.track-name {
  color: #182238;
  font-size: 22rpx;
  line-height: 1.5;
}

.task-switch {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 4rpx;
  border: 1rpx solid #dce8f7;
  border-radius: 14rpx;
  background: #edf4fb;
}

.task-switch-item {
  padding: 10rpx 18rpx;
  border-radius: 10rpx;
  color: #4d6d94;
  font-size: 21rpx;
  font-weight: 600;
}

.task-switch-item-active {
  background: #ffffff;
  color: #1e45b4;
  box-shadow: 0 4rpx 14rpx rgba(52, 92, 160, 0.08);
}

.task-switch-item-done {
  background: #ffffff;
  color: #1c9d6a;
  box-shadow: 0 4rpx 14rpx rgba(52, 92, 160, 0.08);
}

.file-task-list {
  margin-top: 14rpx;
  overflow: hidden;
  border: 1rpx solid #e3ecf7;
  border-radius: 16rpx;
  background: #ffffff;
}

.file-task {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
}

.file-task + .file-task {
  border-top: 1rpx solid #eef3f9;
}

.file-task-main {
  flex: 1;
  min-width: 0;
}

.file-task-title {
  color: #182238;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.5;
}

.file-task-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  color: #7e93ae;
  font-size: 20rpx;
}

.task-priority {
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: #e8f0ff;
  color: #1e45b4;
  font-size: 19rpx;
}

.task-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.task-tag {
  padding: 3rpx 9rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
}

.task-tag-focus { background: #e8f0ff; color: #1e45b4; }
.task-tag-overdue { background: rgba(217, 80, 80, 0.1); color: #d95050; }
.task-tag-plan { background: #f1f5fa; color: #4d6d94; }

.file-task-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 10rpx;
}

.task-action {
  min-width: 66rpx;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: #e8f0ff;
  color: #1e45b4;
  font-size: 21rpx;
  font-weight: 600;
  text-align: center;
}

.task-action-disabled {
  opacity: 0.55;
}


.task-detail {
  margin-top: 14rpx;
  padding: 16rpx;
  border: 1rpx solid #e3ecf7;
  border-radius: 14rpx;
  background: #f7faff;
}

.task-detail-title {
  color: #182238;
  font-size: 23rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.task-detail-copy,
.task-detail-standard {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #e5eefb;
  color: #4d6d94;
  font-size: 21rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.empty-state {
  padding: 42rpx 24rpx 34rpx;
  text-align: center;
}

.empty-state.compact {
  padding: 30rpx 18rpx 12rpx;
}

.empty-page {
  margin-top: 80rpx;
}

.empty-icon {
  color: #2f63e6;
  font-size: 44rpx;
}

.empty-title {
  margin-top: 10rpx;
  color: #182238;
  font-size: 27rpx;
  font-weight: 600;
}

.empty-hint {
  margin-top: 8rpx;
  color: #7e93ae;
  font-size: 21rpx;
  line-height: 1.6;
}

/* 任务展开里的便利贴：与今日页、网页端 TaskStickyInline 对齐 */
.task-sticky { margin-bottom: 14rpx; padding: 18rpx; border-radius: 14rpx; background: rgba(212, 134, 43, 0.08); }
.task-sticky-title { color: #182238; font-size: 24rpx; font-weight: 700; }
.task-sticky-copy { display: block; margin-top: 8rpx; color: #4d6d94; font-size: 22rpx; line-height: 1.6; }
.task-sticky-step { margin-top: 8rpx; color: #182238; font-size: 23rpx; line-height: 1.6; }
.task-sticky-next { margin-top: 10rpx; padding: 12rpx; border-radius: 12rpx; background: rgba(255, 255, 255, 0.72); color: #182238; font-size: 22rpx; line-height: 1.6; }

/* 长期项目：进入下一阶段（与网页 StagePreviewPanel 对齐） */
.stage-advance { display: flex; align-items: center; justify-content: center; height: 68rpx; margin-top: 14rpx; border-radius: 14rpx; background: #2f63e6; color: #ffffff; font-size: 24rpx; font-weight: 600; }
.stage-advance-disabled { opacity: 0.55; }

/* 探索项目：复盘入口（与网页探索项目的「复盘」对齐） */
.review-block { margin-top: 14rpx; padding: 18rpx; border: 1rpx solid #e3ecf7; border-radius: 14rpx; background: #f7faff; }
.review-head { color: #4d6d94; font-size: 22rpx; font-weight: 600; }
.review-empty { margin-top: 10rpx; color: #8296b0; font-size: 22rpx; }
.review-item { margin-top: 10rpx; padding: 12rpx 16rpx; border-radius: 12rpx; background: #ffffff; color: #1e45b4; font-size: 23rpx; }
.review-generate { display: flex; align-items: center; justify-content: center; height: 64rpx; margin-top: 12rpx; border-radius: 12rpx; background: #ffffff; border: 1rpx solid #dce8f7; color: #1e45b4; font-size: 23rpx; font-weight: 600; }
