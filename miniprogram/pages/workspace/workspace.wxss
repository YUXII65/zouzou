.page {
  min-height: 100vh;
  padding-bottom: 130rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #e9f3ff 0%, #f6faff 50%, #eaf8fa 100%);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.72);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.85);
}

.brand-row,
.top-actions {
  display: flex;
  align-items: center;
}

.brand-row { gap: 14rpx; }
.top-actions { gap: 16rpx; }

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: #2f63e6;
}

.brand-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 6rpx solid #ffffff;
  border-right: 6rpx solid #ffffff;
  transform: rotate(45deg) translate(-3rpx, 3rpx);
}

.brand-name {
  color: #182238;
  font-size: 28rpx;
  font-weight: 600;
}

.top-icon,
.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #4d6d94;
  font-size: 28rpx;
}

.avatar {
  background: #e8f0ff;
  color: #1e45b4;
  font-weight: 700;
}

.content { padding: 30rpx 24rpx 40rpx; }

.page-heading {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 28rpx;
}

.eyebrow {
  color: #2f63e6;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.page-title {
  color: #182238;
  font-size: 48rpx;
  font-weight: 700;
}

.panel {
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 18rpx 50rpx rgba(52, 92, 160, 0.1);
}

.projects-panel { overflow: hidden; }

.panel-header {
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid rgba(220, 232, 247, 0.8);
}

.panel-title {
  color: #182238;
  font-size: 30rpx;
  font-weight: 700;
}

.new-project {
  padding: 22rpx 26rpx;
  border-bottom: 1rpx dashed #dce8f7;
  color: #2f63e6;
  font-size: 25rpx;
  font-weight: 600;
}

.empty-state {
  padding: 48rpx 30rpx;
  text-align: center;
}

.empty-state.compact { padding: 34rpx 24rpx 38rpx; }

.empty-icon {
  color: #2f63e6;
  font-size: 44rpx;
}

.empty-text {
  margin-top: 12rpx;
  color: #8296b0;
  font-size: 24rpx;
}

.empty-title {
  margin-top: 16rpx;
  color: #182238;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-hint {
  margin-top: 10rpx;
  color: #4d6d94;
  font-size: 25rpx;
  line-height: 1.65;
}

.detail-panel { margin-top: 24rpx; }

.bottom-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.9);
  border-top: 1rpx solid rgba(220, 232, 247, 0.9);
}

.nav-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #8296b0;
  font-size: 22rpx;
}

.nav-item-active {
  color: #2f63e6;
  font-weight: 600;
}

.nav-icon { font-size: 32rpx; line-height: 1; }