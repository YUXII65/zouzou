.page {
  min-height: 100vh;
  padding-bottom: 130rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #e9f3ff 0%, #f6faff 50%, #eaf8fa 100%);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.72);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.85);
}

.brand-row,
.top-actions {
  display: flex;
  align-items: center;
}

.brand-row { gap: 14rpx; }
.top-actions { gap: 16rpx; }

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: #2f63e6;
}

.brand-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 6rpx solid #ffffff;
  border-right: 6rpx solid #ffffff;
  transform: rotate(45deg) translate(-3rpx, 3rpx);
}

.brand-name {
  color: #182238;
  font-size: 28rpx;
  font-weight: 600;
}

.top-icon,
.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #4d6d94;
  font-size: 28rpx;
}

.avatar {
  background: #e8f0ff;
  color: #1e45b4;
  font-weight: 700;
}

.content { padding: 30rpx 24rpx 40rpx; }

.page-heading {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 28rpx;
}

.eyebrow {
  color: #2f63e6;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.page-title {
  color: #182238;
  font-size: 48rpx;
  font-weight: 700;
}

.panel {
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 18rpx 50rpx rgba(52, 92, 160, 0.1);
}

.projects-panel { overflow: hidden; }

.panel-header {
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid rgba(220, 232, 247, 0.8);
}

.panel-title {
  color: #182238;
  font-size: 30rpx;
  font-weight: 700;
}

.new-project {
  padding: 22rpx 26rpx;
  border-bottom: 1rpx dashed #dce8f7;
  color: #2f63e6;
  font-size: 25rpx;
  font-weight: 600;
}

.empty-state {
  padding: 48rpx 30rpx;
  text-align: center;
}

.empty-state.compact { padding: 34rpx 24rpx 38rpx; }

.empty-icon {
  color: #2f63e6;
  font-size: 44rpx;
}

.empty-text {
  margin-top: 12rpx;
  color: #8296b0;
  font-size: 24rpx;
}

.empty-title {
  margin-top: 16rpx;
  color: #182238;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-hint {
  margin-top: 10rpx;
  color: #4d6d94;
  font-size: 25rpx;
  line-height: 1.65;
}

.detail-panel { margin-top: 24rpx; }

.bottom-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.9);
  border-top: 1rpx solid rgba(220, 232, 247, 0.9);
}

.nav-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #8296b0;
  font-size: 22rpx;
}

.nav-item-active {
  color: #2f63e6;
  font-weight: 600;
}

.nav-icon { font-size: 32rpx; line-height: 1; }.create-form { padding: 0 26rpx 24rpx; }
.form-input { width: 100%; height: 78rpx; margin-top: 16rpx; padding: 0 20rpx; box-sizing: border-box; border-radius: 14rpx; background: #edf4fb; color: #182238; font-size: 25rpx; }
.form-button { display: flex; align-items: center; justify-content: center; height: 78rpx; margin-top: 18rpx; border-radius: 14rpx; background: #2f63e6; color: #ffffff; font-size: 25rpx; font-weight: 600; }
.project-list { padding: 12rpx; }
.project-item { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 22rpx; border-radius: 14rpx; color: #4d6d94; font-size: 25rpx; }
.project-item-active { background: #e8f0ff; color: #1e45b4; font-weight: 600; }
.project-count { color: #8296b0; font-size: 21rpx; }
.project-meta { display: flex; flex-direction: column; gap: 18rpx; padding: 24rpx 26rpx; }
.meta-label { display: block; color: #8296b0; font-size: 21rpx; }
.meta-value { display: block; margin-top: 6rpx; color: #4d6d94; font-size: 25rpx; line-height: 1.6; }
.task-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 20rpx 26rpx; border-top: 1rpx solid #eef3f9; }
.task-title { flex: 1; color: #182238; font-size: 25rpx; }
.task-status { color: #8296b0; font-size: 21rpx; }
.delete-project { margin: 24rpx 26rpx 30rpx; padding: 16rpx; border-radius: 14rpx; background: rgba(217, 80, 80, 0.1); color: #d95050; font-size: 24rpx; font-weight: 600; text-align: center; }

/* 未关联任务与任务行：与网页端 WorkspaceProjectBrowser / TaskRow 对齐 */
.project-item-unassigned { margin-top: 8rpx; border-top: 1rpx dashed #dce8f7; }
.project-unassigned-copy { display: flex; min-width: 0; align-items: center; gap: 10rpx; }
.project-unassigned-icon { flex-shrink: 0; color: #8296b0; font-size: 26rpx; }
.task-copy { flex: 1; min-width: 0; }
.task-meta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx; margin-top: 8rpx; }
.task-priority, .task-status { padding: 4rpx 10rpx; border-radius: 999rpx; background: #e8f0ff; color: #1e45b4; font-size: 20rpx; line-height: 1.3; }
.task-status { background: #f1f5fa; color: #4d6d94; }
.task-action { flex-shrink: 0; padding: 10rpx 16rpx; border-radius: 12rpx; background: #e8f0ff; color: #1e45b4; font-size: 22rpx; font-weight: 600; }