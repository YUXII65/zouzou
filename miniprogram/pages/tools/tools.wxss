.page {
  min-height: 100vh;
  padding-bottom: 130rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #e9f3ff 0%, #f6faff 50%, #eaf8fa 100%);
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.72);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.85);
}
.brand-row, .top-actions { display: flex; align-items: center; }
.brand-row { gap: 14rpx; }
.top-actions { gap: 16rpx; }
.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: #2f63e6;
}
.brand-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 6rpx solid #ffffff;
  border-right: 6rpx solid #ffffff;
  transform: rotate(45deg) translate(-3rpx, 3rpx);
}
.brand-name { color: #182238; font-size: 28rpx; font-weight: 600; }
.top-icon, .avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #4d6d94;
  font-size: 28rpx;
}
.top-icon.active { color: #2f63e6; background: #e8f0ff; }
.avatar { background: #e8f0ff; color: #1e45b4; font-weight: 700; }
.content { padding: 30rpx 24rpx 40rpx; }
.page-heading { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 28rpx; }
.eyebrow { color: #2f63e6; font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; }
.page-title { color: #182238; font-size: 48rpx; font-weight: 700; }
.page-subtitle { color: #4d6d94; font-size: 24rpx; }
.panel {
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 18rpx 50rpx rgba(52, 92, 160, 0.1);
}
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid rgba(220, 232, 247, 0.8);
}
.panel-title { color: #182238; font-size: 30rpx; font-weight: 700; }
.panel-count { color: #8296b0; font-size: 23rpx; }.stat-grid { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 24rpx; }
.stat-card { flex: 1; min-width: 150rpx; padding: 22rpx; border-radius: 16rpx; }
.stat-card.warning { background: rgba(212, 134, 43, 0.08); }
.stat-card.accent { background: rgba(232, 240, 255, 0.92); }
.stat-card.success { background: rgba(28, 157, 106, 0.08); }
.stat-card.ai { background: rgba(15, 174, 200, 0.09); }
.stat-label { display: block; color: #4d6d94; font-size: 22rpx; }
.stat-number { display: block; margin-top: 8rpx; color: #182238; font-size: 44rpx; font-weight: 700; }
.attention-body { padding: 26rpx; color: #4d6d94; font-size: 25rpx; }
.module { border-bottom: 1rpx solid rgba(220, 232, 247, 0.8); }
.module:last-child { border-bottom: 0; }
.module-main { display: flex; gap: 18rpx; padding: 26rpx 26rpx 0; }
.module-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #edf4fb;
  color: #4d6d94;
  font-size: 34rpx;
}
.module-copy { flex: 1; min-width: 0; }
.module-title-row { display: flex; align-items: center; gap: 12rpx; }
.module-title { color: #182238; font-size: 28rpx; font-weight: 700; }
.module-badge { padding: 4rpx 10rpx; border-radius: 8rpx; background: #edf4fb; color: #8296b0; font-size: 20rpx; }
.module-badge-open { background: #e8f0ff; color: #1e45b4; }
.module-desc { display: block; margin-top: 8rpx; color: #4d6d94; font-size: 24rpx; line-height: 1.65; }
.module-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 70rpx;
  margin: 20rpx 26rpx 24rpx;
  border: 1rpx solid #dce8f7;
  border-radius: 14rpx;
  color: #4d6d94;
  font-size: 24rpx;
  font-weight: 600;
}
.module-action-open { background: #ffffff; }
.module-action-active { background: #2f63e6; border-color: #2f63e6; color: #ffffff; }
.module-action-disabled { background: #edf4fb; color: #9aabc2; }
.module-expand { margin: 0 26rpx 26rpx; padding: 22rpx; border-radius: 18rpx; background: #f4f8ff; }
.timer-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.timer-label { display: block; color: #4d6d94; font-size: 22rpx; }
.timer-time { display: block; margin-top: 8rpx; color: #182238; font-size: 44rpx; font-weight: 700; }
.timer-finished { color: #2f63e6; }
.timer-modes { display: flex; flex-wrap: wrap; gap: 10rpx; }
.timer-mode { padding: 10rpx 14rpx; border: 1rpx solid #dce8f7; border-radius: 10rpx; color: #4d6d94; font-size: 21rpx; }
.timer-mode-active { background: #2f63e6; border-color: #2f63e6; color: #ffffff; }
.timer-actions { display: flex; gap: 14rpx; margin-top: 20rpx; }
.timer-button { padding: 14rpx 24rpx; border-radius: 12rpx; background: #2f63e6; color: #ffffff; font-size: 24rpx; font-weight: 600; }
.timer-reset { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 60rpx; border: 1rpx solid #dce8f7; border-radius: 12rpx; color: #4d6d94; font-size: 28rpx; }
.week-grid { display: flex; gap: 12rpx; flex-wrap: wrap; }
.week-grid > view { flex: 1; min-width: 130rpx; }
.week-label { display: block; color: #4d6d94; font-size: 21rpx; }
.week-label.success { color: #1c9d6a; }
.week-label.warning { color: #d4862b; }
.week-number { display: block; margin-top: 6rpx; color: #182238; font-size: 34rpx; font-weight: 700; }
.review-button { display: inline-block; margin-top: 20rpx; padding: 14rpx 22rpx; border-radius: 12rpx; background: #2f63e6; color: #ffffff; font-size: 23rpx; font-weight: 600; }
.export-body { padding: 26rpx; }
.export-body > text { display: block; color: #4d6d94; font-size: 25rpx; line-height: 1.65; }
.export-button { display: inline-block; margin-top: 20rpx; padding: 16rpx 24rpx; border-radius: 14rpx; background: #2f63e6; color: #ffffff; font-size: 24rpx; font-weight: 600; }
.bottom-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.9);
  border-top: 1rpx solid rgba(220, 232, 247, 0.9);
}
.nav-item { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; color: #8296b0; font-size: 22rpx; }
.nav-icon { font-size: 32rpx; line-height: 1; }.attention-item { margin-top: 10rpx; padding: 14rpx 16rpx; border-radius: 12rpx; background: #edf4fb; color: #4d6d94; font-size: 24rpx; }
