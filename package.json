{
  "name": "zouzou",
  "version": "2.5.0",
  "private": true,
  "description": "走走：把零散想法收成下一步的 AI 个人项目推进系统",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "build:edgeone": "prisma generate && prisma migrate deploy && node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:backup": "node scripts/backup-db.mjs",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:reset": "node scripts/reset-user-data.mjs --yes",
    "db:seed:demo": "node scripts/seed-demo-data.mjs --force",
    "public:demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-public-demo.ps1",
    "public:demo:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-public-demo.ps1 -Reset",
    "eval:ai": "node scripts/evaluate-ai.mjs",
    "metrics:ai": "node scripts/ai-metrics.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.28.0",
    "lunar-javascript": "^1.7.7",
    "next": "15.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.9.0"
}
