{
  "name": "zouzou",
  "version": "3.5.0",
  "private": true,
  "description": "走走：把零散想法收成下一步的 AI 个人项目推进系统",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "build:edgeone": "prisma generate && prisma migrate deploy && node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "check:online": "node scripts/check-online-readiness.mjs",
    "check:review": "node scripts/check-miniprogram-review.mjs",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:backup": "node scripts/backup-db.mjs",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:reset": "node scripts/reset-user-data.mjs --yes",
    "db:seed:demo": "node scripts/seed-demo-data.mjs --force",
    "public:demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-public-demo.ps1",
    "public:demo:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-public-demo.ps1 -Reset",
    "eval:ai": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/evaluate-ai.mjs",
    "eval:clarify": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/evaluate-clarification.mjs",
    "eval:mode": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/evaluate-mode-judgment.mjs",
    "eval:first-run": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/evaluate-first-run.mjs",
    "verify:clarify-flow": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-alias-loader.mjs scripts/verify-clarification-flow.mjs",
    "verify:clarify-retry": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-alias-loader.mjs scripts/verify-clarify-retry-idempotent.mjs",
    "metrics:ai": "node scripts/ai-metrics.mjs",
    "audit:plan-quality": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-plan-quality.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-alias-loader.mjs --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "db:verify": "node scripts/restore-db.mjs",
    "db:verify:restore": "node scripts/verify-restore.mjs",
    "db:verify:restore:fixture": "node scripts/verify-restore.mjs --fixture",
    "verify:miniprogram": "node scripts/verify-miniprogram.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.28.0",
    "next": "15.5.27",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@next/eslint-plugin-next": "15.5.27",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "6.10.0",
    "eslint-plugin-react": "7.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0"
}
